<?xml version="1.0" encoding="utf-8"?>
<!-- Chip text: focus/selected = primary white, default = secondary. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/kl3_text_primary" />
    <item android:state_selected="true" android:color="@color/kl3_on_accent" />
    <item android:state_pressed="true" android:color="@color/kl3_text_primary" />
    <item android:color="@color/kl3_text_secondary" />
</selector>
