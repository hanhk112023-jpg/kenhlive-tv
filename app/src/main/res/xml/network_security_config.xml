<?xml version="1.0" encoding="utf-8"?>
<!-- Cho phép cleartext traffic (HTTP) cho các luồng phát truyền hình IPTV từ playlist M3U tùy chỉnh của người dùng (ví dụ máy chủ watchtivo, ciao-ott, xtream codes và các đài địa phương phát HTTP). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
