<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl_bg_deep">

    <!-- Apple Filter Pills Bar (Horizontal) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/phimFilterList"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Phim Content Nested Scroll or Vertical RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/phimMainList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="40dp"
            android:scrollbars="none" />

        <!-- Loading Bar -->
        <ProgressBar
            android:id="@+id/phimLoading"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Error / Empty State Container -->
        <LinearLayout
            android:id="@+id/phimErrorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPhimEmptyIll"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ill_empty_cinema"
                android:scaleType="fitCenter"
                android:contentDescription="Minh họa lịch sử xem" />

            <TextView
                android:id="@+id/tvPhimErrorTitle"
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không thể tải kho phim"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPhimErrorSub"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kiểm tra kết nối mạng hoặc thử lại sau"
                android:textColor="@color/kl_text_3"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPhimRetry"
                style="@style/KL.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:text="Thử lại"
                android:focusable="true" />
        </LinearLayout>

        <!-- Netflix Full-Screen Search Overlay -->
        <LinearLayout
            android:id="@+id/phimSearchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0B0E14"
            android:visibility="gone"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Search Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Search Input Container -->
                <LinearLayout
                    android:id="@+id/searchPhimInputContainer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_input_bg"
                    android:gravity="center_vertical"
                    android:paddingLeft="14dp"
                    android:paddingRight="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_search"
                        android:contentDescription="Tìm kiếm"
                        app:tint="#94A3B8" />

                    <EditText
                        android:id="@+id/etSearchPhim"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="8dp"
                        android:background="@null"
                        android:hint="Tìm phim, anime, diễn viên (VD: One Piece, Conan, Lật Mặt...)"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearchPhim"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:contentDescription="Xóa chữ"
                        android:visibility="gone"
                        android:focusable="true"
                        app:tint="#94A3B8" />
                </LinearLayout>

                <!-- Search Action Button -->
                <Button
                    android:id="@+id/btnDoSearchPhim"
                    style="@style/KL.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="12dp"
                    android:text="Tìm kiếm"
                    android:textSize="13sp"
                    android:focusable="true" />

                <!-- Close / Back Button -->
                <Button
                    android:id="@+id/btnCloseSearchPhim"
                    style="@style/KL.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:text="✕ Đóng"
                    android:textSize="13sp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Trending Suggestions Chips Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Thịnh hành:"
                    android:textColor="#FF8A00"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginRight="10dp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/searchTrendingContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Status / Results Summary Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSearchResultsStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gợi ý phim thịnh hành"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbSearchPhim"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminateTint="#FF8A00"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Netflix 5-Column Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSearchGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingBottom="24dp"
                android:scrollbars="none" />

            <!-- Empty Search State -->
            <LinearLayout
                android:id="@+id/llSearchEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSearchEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không tìm thấy phim phù hợp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thử tìm kiếm với từ khóa khác hoặc bấm chọn các gợi ý thịnh hành phía trên"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
