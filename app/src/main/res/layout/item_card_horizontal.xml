<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp"
    android:layout_margin="6dp"
    android:background="@drawable/card_live_bg"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="110dp">

        <View
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/avatar_ring" />

        <ImageView
            android:id="@+id/cardAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="#232B42"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="1dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_live"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardBlv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/cardMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#C3CBDF"
        android:textSize="11sp"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/cardViewers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#0B0F19"
        android:background="@drawable/pill_viewers"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>