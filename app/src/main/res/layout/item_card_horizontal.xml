<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:background="@drawable/card_focus_bg"
    android:padding="6dp"
    android:focusable="true"
    android:clickable="true">

    <!-- THUMBNAIL 16:9 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="169dp">

        <ImageView
            android:id="@+id/cardThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_round_bg"
            android:contentDescription="@string/app_name" />

        <!-- LIVE badge góc trên-trái -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="8dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_live"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- badge N phòng góc trên-phải -->
        <TextView
            android:id="@+id/roomBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:background="@drawable/room_badge_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone" />

        <!-- scrim đáy + avatar BLV nhỏ + viewers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/thumb_bottom_scrim"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <ImageView
                android:id="@+id/cardAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                android:background="@drawable/avatar_mask"
                android:contentDescription="blv" />

            <TextView
                android:id="@+id/cardBlv"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/cardViewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/oswald"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </FrameLayout>

    <!-- TÊN TRẬN 2 dòng + giải -->
    <TextView
        android:id="@+id/cardMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/oswald"
        android:textSize="15sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2" />

</LinearLayout>