<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kl3i_dialog_bg"
    android:padding="@dimen/kl3_sp_xl">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:background="@drawable/kl3i_icon_box">

            <ImageView
                android:layout_width="@dimen/kl3_crest_s"
                android:layout_height="@dimen/kl3_crest_s"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_tv"
                android:tint="@color/kl3_accent"
                android:contentDescription="IPTV M3U" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_sp_md"
            android:orientation="vertical">

            <TextView
                style="@style/KL3.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANH SÁCH PHÁT M3U TÙY CHỈNH" />

            <TextView
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="Tự do thêm nguồn kênh truyền hình M3U / M3U8 của bạn" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_divider_h"
        android:layout_marginTop="@dimen/kl3_sp_lg"
        android:layout_marginBottom="@dimen/kl3_sp_lg"
        android:background="@drawable/kl3_divider" />

    <!-- Label -->
    <TextView
        style="@style/KL3.Text.Micro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐƯỜNG DẪN LINK M3U HOẶC M3U8:"
        android:textColor="@color/kl3_accent"
        android:textStyle="bold" />

    <!-- Input -->
    <EditText
        android:id="@+id/edtM3uUrl"
        style="@style/KL3.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_sm"
        android:hint="https://example.com/list.m3u hoặc link M3U của bạn"
        android:inputType="textUri" />

    <!-- Quick action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_md"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnM3uClear"
            style="@style/KL3.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/kl3_btn_h_s"
            android:paddingLeft="@dimen/kl3_sp_lg"
            android:paddingRight="@dimen/kl3_sp_lg"
            android:text="Xóa link"
            android:textColor="@color/kl3_error"
            android:textSize="@dimen/kl3_ts_meta" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_divider_h"
        android:layout_marginTop="@dimen/kl3_sp_lg"
        android:layout_marginBottom="@dimen/kl3_sp_lg"
        android:background="@drawable/kl3_divider" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <Button
            android:id="@+id/btnM3uClose"
            style="@style/KL3.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đóng"
            android:textColor="@color/kl3_text_primary" />

        <Button
            android:id="@+id/btnM3uSave"
            style="@style/KL3.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_md"
            android:text="LƯU &amp; NẠP KÊNH"
            android:textColor="@color/kl3_on_accent" />
    </LinearLayout>

</LinearLayout>
