<?xml version="1.0" encoding="utf-8"?>
<!-- THẺ POSTER LƯỚI (grid + search grid) — KL3.
     Poster @dimen/phim_grid_poster_h (tỉ lệ theo cột lưới), placeholder
     kl3_poster_placeholder bo kl3_r_md; badge chất lượng KL3.Badge.Hd,
     badge tập/xem-tiếp KL3.Pill; focus ring kl3_fg_focus foreground
     (code vẫn scale 1.08 + elevation). Giữ nguyên mọi android:id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/kl3_sp_xs"
    android:orientation="vertical"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:elevation="@dimen/kl3_elev_1"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Poster Container (2:3 Cinema Proportions) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/phim_grid_poster_h">

        <ImageView
            android:id="@+id/gridPhimPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:background="@drawable/kl3_poster_placeholder"
            android:contentDescription="Poster phim" />

        <!-- Top Left Rating Badge (KL3 gold — code đang ẩn, giữ id) -->
        <TextView
            android:id="@+id/gridPhimRatingBadge"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:text="★ 8.8"
            android:textSize="@dimen/kl3_ts_badge"
            android:letterSpacing="0.04" />

        <!-- Top Right Quality Badge (KL3 HD amber) -->
        <TextView
            android:id="@+id/gridPhimQualityBadge"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:text="FHD"
            android:textSize="@dimen/kl3_ts_badge"
            android:letterSpacing="0.06" />

        <!-- Bottom Left Episode / Status Badge (KL3 glass pill) -->
        <TextView
            android:id="@+id/gridPhimEpisodeBadge"
            style="@style/KL3.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:gravity="center"
            android:text="Tập 1"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/kl3_text_primary" />
    </FrameLayout>

    <!-- Info Container below Poster -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/kl3_sp_xs"
        android:paddingBottom="@dimen/kl3_sp_xs"
        android:paddingLeft="@dimen/kl3_sp_xs"
        android:paddingRight="@dimen/kl3_sp_xs">

        <TextView
            android:id="@+id/gridPhimTitle"
            style="@style/KL3.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/gridPhimMeta"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
