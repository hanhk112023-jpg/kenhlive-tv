<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="26dp"
    android:paddingBottom="26dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_telegram"
            android:contentDescription="Telegram" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG BÁO"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HỖ TRỢ &amp; XỬ LÝ SỰ CỐ TRỰC TUYẾN"
                android:textColor="@color/kl_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="KENHLIVE TV"
            android:textColor="@color/kl_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="#222838" />

    <!-- Two-Column Body: Exact Announcement Text (Left) + Telegram QR Code Card (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Left Column: Exact Message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nếu bạn gặp lỗi, sự cố hoặc bất kỳ vấn đề nào trong quá trình sử dụng, vui lòng liên hệ với chúng tôi để được hỗ trợ và xử lý sớm nhất."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Vui lòng cung cấp: mô tả lỗi, ảnh/video hoặc thông tin liên quan nếu có."
                android:textColor="@color/kl_brand"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Cảm ơn bạn đã thông báo và đóng góp để hệ thống ngày càng hoàn thiện."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Right Column: QR Code & Direct Handle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_badge_glass"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_qr_container"
                android:gravity="center"
                android:padding="8dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgQrTelegram"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:src="@drawable/qr_telegram_feedback"
                    android:scaleType="fitCenter"
                    android:contentDescription="Mã QR Telegram Báo Lỗi" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTelegramHandle"
                style="@style/KL.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Telegram: @T990512S"
                android:textColor="@color/kl_brand"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelegramUrl"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="https://t.me/T990512S"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quét mã QR bằng điện thoại"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCloseFeedback"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_orange"
            android:text="ĐÃ HIỂU / ĐÓNG"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:focusable="true"
            android:nextFocusRight="@+id/btnOpenTelegram" />

        <Button
            android:id="@+id/btnOpenTelegram"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:background="@drawable/bg_button_ghost"
            android:text="MỞ TELEGRAM"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnCloseFeedback" />
    </LinearLayout>

</LinearLayout>
