<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kl3i_dialog_bg"
    android:padding="@dimen/kl3_sp_xl">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:background="@drawable/kl3i_icon_box">

            <ImageView
                android:layout_width="@dimen/kl3_crest_s"
                android:layout_height="@dimen/kl3_crest_s"
                android:layout_gravity="center"
                android:src="@drawable/ic_telegram"
                android:tint="@color/kl3_accent"
                android:contentDescription="Telegram" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_md"
            android:orientation="vertical">

            <TextView
                style="@style/KL3.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG BÁO" />

            <TextView
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="NHÓM THẢO LUẬN &amp; HỖ TRỢ TRỰC TUYẾN"
                android:textColor="@color/kl3_accent" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            style="@style/KL3.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KENHLIVE TV"
            android:textColor="@color/kl3_info"
            android:textSize="@dimen/kl3_ts_micro"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_divider_h"
        android:layout_marginTop="@dimen/kl3_sp_lg"
        android:layout_marginBottom="@dimen/kl3_sp_lg"
        android:background="@drawable/kl3_divider" />

    <!-- Body 2 cột: nội dung + QR Telegram -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/kl3_sp_xl"
            android:orientation="vertical">

            <TextView
                style="@style/KL3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chào mừng bạn đến với cộng đồng KenhLive TV! Vui lòng tham gia nhóm Telegram để cùng thảo luận, chia sẻ trải nghiệm, nhận lịch thi đấu nóng hổi và được hỗ trợ nhanh chóng nhất."
                android:lineSpacingExtra="4dp" />

            <TextView
                style="@style/KL3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_md"
                android:text="Tại nhóm Telegram, bạn có thể: báo lỗi kênh, yêu cầu thêm giải đấu/phim truyện hoặc nhận file cập nhật mới nhất."
                android:textColor="@color/kl3_accent"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <TextView
                style="@style/KL3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_md"
                android:text="Cảm ơn bạn đã luôn đồng hành và ủng hộ KenhLive TV."
                android:textColor="@color/kl3_text_secondary"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- QR card -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/kl3_pill_bg"
            android:padding="@dimen/kl3_sp_lg">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/kl3i_card_logo_bg"
                android:gravity="center"
                android:padding="@dimen/kl3_sp_sm">

                <ImageView
                    android:id="@+id/imgQrTelegram"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:src="@drawable/qr_telegram_feedback"
                    android:scaleType="fitCenter"
                    android:contentDescription="Mã QR Nhóm Telegram KenhLive TV" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTelegramHandle"
                style="@style/KL3.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_md"
                android:text="Nhóm Telegram: @kenhlivetv"
                android:textColor="@color/kl3_accent" />

            <TextView
                android:id="@+id/tvTelegramUrl"
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="https://t.me/kenhlivetv" />

            <TextView
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="Quét mã QR để vào nhóm" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_xl"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCloseFeedback"
            style="@style/KL3.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐÃ HIỂU / ĐÓNG"
            android:textColor="@color/kl3_on_accent"
            android:focusable="true"
            android:nextFocusRight="@+id/btnOpenTelegram" />

        <Button
            android:id="@+id/btnOpenTelegram"
            style="@style/KL3.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_md"
            android:text="VÀO NHÓM TELEGRAM"
            android:textColor="@color/kl3_text_primary"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnCloseFeedback" />
    </LinearLayout>

</LinearLayout>
