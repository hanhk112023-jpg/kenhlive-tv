<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="26dp"
    android:paddingBottom="26dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_telegram"
            android:contentDescription="Telegram" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG BÁO MỚI &amp; BÁO LỖI"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KENHLIVE TV · HỖ TRỢ TRỰC TUYẾN QUA TELEGRAM"
                android:textColor="@color/kl_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="BẢN v7.4.0"
            android:textColor="@color/kl_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="#222838" />

    <!-- Two-Column Body: Announcement Content (Left) + Telegram QR Code Card (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Left Column: Details & Instructions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ Giao diện Cổng Chọn mới:"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="Chọn nhanh 3 mục Thể Thao, Truyền Hình, Phim Truyện với phím bấm D-pad rộng rãi."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ Nguồn phát thể thao độc lập:"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="Gà Vàng TV, Khán Đài TV, ColaTV và Socolive đã kết nối luồng riêng, không còn bị nhầm lẫn luồng phát."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ Báo lỗi &amp; Góp ý kênh:"
                android:textColor="@color/kl_brand"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nếu gặp lỗi mất kênh, đứng hình hoặc yêu cầu thêm nội dung, vui lòng nhắn tin trực tiếp qua Telegram để được xử lý ngay!"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Right Column: QR Code & Direct Handle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_badge_glass"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_qr_container"
                android:gravity="center"
                android:padding="8dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/imgQrTelegram"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:src="@drawable/qr_telegram_feedback"
                    android:scaleType="fitCenter"
                    android:contentDescription="Mã QR Telegram Báo Lỗi" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTelegramHandle"
                style="@style/KL.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Telegram: @T990512S"
                android:textColor="@color/kl_brand"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelegramUrl"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="https://t.me/T990512S"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quét mã QR bằng điện thoại"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCloseFeedback"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_orange"
            android:text="ĐÃ HIỂU / ĐÓNG"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:focusable="true"
            android:nextFocusRight="@+id/btnOpenTelegram" />

        <Button
            android:id="@+id/btnOpenTelegram"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:background="@drawable/bg_button_ghost"
            android:text="MỞ TELEGRAM"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnCloseFeedback" />
    </LinearLayout>

</LinearLayout>
