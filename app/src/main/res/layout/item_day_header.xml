<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 day header — phân tách các ngày trong Schedule/SportAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/kl3_margin_x"
    android:paddingRight="@dimen/kl3_margin_x"
    android:paddingTop="@dimen/kl3_gap_l"
    android:paddingBottom="@dimen/kl3_gap">

    <View
        android:layout_width="@dimen/kl3_section_bar_w"
        android:layout_height="@dimen/kl3_ts_section"
        android:background="@drawable/kl3s_section_bar"
        android:layout_marginRight="@dimen/kl3_sp_md" />

    <TextView
        android:id="@+id/dayLabel"
        style="@style/KL3.Text.Section"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06" />

    <TextView
        android:id="@+id/dayCount"
        style="@style/KL3.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kl3_pill_bg"
        android:paddingLeft="@dimen/kl3_sp_md"
        android:paddingRight="@dimen/kl3_sp_md"
        android:paddingTop="@dimen/kl3_sp_xs"
        android:paddingBottom="@dimen/kl3_sp_xs" />
</LinearLayout>
