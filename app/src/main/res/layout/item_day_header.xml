<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/sp_screen_margin"
    android:paddingRight="@dimen/sp_screen_margin"
    android:paddingTop="@dimen/sp_row_gap"
    android:paddingBottom="8dp">

    <View
        android:layout_width="4dp"
        android:layout_height="18dp"
        android:background="@drawable/kl2_section_bar"
        android:layout_marginRight="9dp" />

    <TextView
        android:id="@+id/dayLabel"
        style="@style/KL.Text.Section"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06" />

    <TextView
        android:id="@+id/dayCount"
        style="@style/KL.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_glass"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
