<?xml version="1.0" encoding="utf-8"?>
<!-- Ô multiview. TextureView (không phải SurfaceView): SurfaceView + ZOOM tràn ra ngoài ô
     vì surface hệ thống không clip theo parent → live nạp sau đè live trước.
     TextureView render trong view hierarchy → clip đúng ô + viền focus đè lên được. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants">

    <androidx.media3.ui.PlayerView
        android:id="@+id/cellPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kl3_bg"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="@drawable/kl3p_scrim_top" />

    <TextView
        android:id="@+id/cellLabel"
        style="@style/KL3.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="@dimen/kl3_margin_x"
        android:layout_marginTop="@dimen/kl3_sp_md"
        android:layout_marginRight="90dp"
        android:textSize="@dimen/kl3_ts_meta"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="320dp" />

    <TextView
        android:id="@+id/cellAudio"
        style="@style/KL3.Badge.Provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginRight="@dimen/kl3_margin_x"
        android:layout_marginTop="@dimen/kl3_sp_md"
        android:text=""
        android:textSize="@dimen/kl3_ts_badge"
        android:textStyle="bold"
        android:letterSpacing="0.07" />

    <TextView
        android:id="@+id/cellSwapHint"
        style="@style/KL3.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="@dimen/kl3_margin_x"
        android:layout_marginBottom="@dimen/kl3_margin_x"
        android:text="@string/mv_swap_hint"
        android:textColor="@color/kl3_text_secondary"
        android:textSize="@dimen/kl3_ts_micro"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
