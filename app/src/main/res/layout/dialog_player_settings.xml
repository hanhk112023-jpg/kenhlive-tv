<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@drawable/kl3p_dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/kl3_sp_xl"
        android:paddingRight="@dimen/kl3_sp_xl"
        android:paddingTop="@dimen/kl3_sp_lg"
        android:paddingBottom="@dimen/kl3_sp_lg">

        <!-- Tiêu đề Dialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/kl3_section_bar_w"
                android:layout_height="20dp"
                android:background="@color/kl3_accent"
                android:layout_marginRight="@dimen/kl3_sp_sm" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/KL3.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_settings_title" />

                <TextView
                    style="@style/KL3.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_xs"
                    android:text="@string/player_settings_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/kl3_divider_h"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:layout_marginBottom="@dimen/kl3_sp_sm"
            android:background="@drawable/kl3_divider" />

        <!-- Nhóm: Chất lượng hình ảnh -->
        <TextView
            android:id="@+id/videoHeader"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kl3_accent_bright"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="@string/player_video_label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/videoOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/videoStatus"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_tertiary"
            android:text="" />

        <!-- Nhóm: Chế độ âm thanh -->
        <TextView
            android:id="@+id/audioHeader"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:textColor="@color/kl3_accent_bright"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="@string/player_audio_label" />

        <HorizontalScrollView
            android:id="@+id/audioScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/audioOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/audioStatus"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_tertiary"
            android:text="" />

        <!-- Nhóm: Tỉ lệ khung hình -->
        <TextView
            android:id="@+id/aspectHeader"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:textColor="@color/kl3_accent_bright"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="@string/player_display_label" />

        <HorizontalScrollView
            android:id="@+id/aspectScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/aspectOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/aspectStatus"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_tertiary"
            android:text="" />

        <!-- Nhóm: Bước tua -->
        <TextView
            android:id="@+id/seekHeader"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:textColor="@color/kl3_accent_bright"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:text="@string/player_seek_label" />

        <HorizontalScrollView
            android:id="@+id/seekScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/seekOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/seekStatus"
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_tertiary"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/kl3_divider_h"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:layout_marginBottom="@dimen/kl3_sp_sm"
            android:background="@drawable/kl3_divider" />

        <TextView
            style="@style/KL3.Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/kl3_text_tertiary"
            android:text="@string/player_hint_tv" />

    </LinearLayout>
</ScrollView>
