<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/sp_card_gap"
    android:background="@drawable/bg_card_match"
    android:foreground="@drawable/fg_card_focus_cyan"
    android:padding="14dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: League tag (left) + Countdown pill AMBER (right) (Phong cách FotMob / SofaScore) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fxLeague"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_league_cyan"
            android:textColor="@color/kl_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:ellipsize="end" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/fxCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kl_amber"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_countdown"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2: Trung tâm trận đấu sắp đá (Host | Giờ đấu | Guest) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="58dp">

        <!-- Đội nhà -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/fxHost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/kl_text_1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/fxHostIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ic_sports"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Giờ thi đấu to rõ đặt trong Pill Dark Slate -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/fxTime"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:background="@drawable/bg_score_pill"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/oswald"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Đội khách -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <ImageView
                android:id="@+id/fxGuestIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ic_sports"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/fxGuest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/kl_text_1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Đường chia hairline mờ thanh thoát -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#151A24" />

    <!-- Row 3: Ngày thi đấu + Danh sách BLV dự kiến phân bổ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fxDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/kl_text_2"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/fxAnchorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>

    <!-- Ẩn các trường tương thích cũ không làm vỡ code Kotlin -->
    <TextView
        android:id="@+id/fxMatchTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
