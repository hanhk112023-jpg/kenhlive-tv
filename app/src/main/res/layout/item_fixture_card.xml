<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/sp_card_gap"
    android:background="@drawable/bg_card"
    android:foreground="@drawable/fg_focus"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/fxLeague"
        style="@style/KL.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/kl_text_3"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp">

        <TextView
            android:id="@+id/fxHost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="@color/kl_text_1"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:id="@+id/fxTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kl_text_1"
                android:fontFamily="@font/oswald"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/fxDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kl_text_3"
                android:textSize="11sp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <TextView
            android:id="@+id/fxGuest"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:textColor="@color/kl_text_1"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/fxAnchorRow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/fxCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
