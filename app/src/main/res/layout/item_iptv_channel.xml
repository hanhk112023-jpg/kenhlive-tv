<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_match"
    android:foreground="@drawable/fg_card_focus_cyan"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_horizontal">

    <!-- Logo kênh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#15161E">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />

        <!-- Badge LIVE nhỏ trên góc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="4dp"
            android:text="OTT"
            android:textColor="@color/kl_cyan"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_league_cyan"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </FrameLayout>

    <!-- Tên kênh -->
    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/kl_text_1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Kênh TV" />

    <!-- Thể loại / Nhóm kênh -->
    <TextView
        android:id="@+id/channelGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/kl_text_3"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Truyền hình" />

</LinearLayout>
