<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="7dp"
    android:background="@drawable/bg_iptv_channel_card"
    android:foreground="@drawable/fg_iptv_focus"
    android:focusable="true"
    android:clickable="true">

    <!-- Top: Logo Container nền đen sâu tỉ lệ 16:9 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="#000000">

        <!-- Logo Kênh căn giữa gọn gàng -->
        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />

        <!-- Tag Nhóm Kênh (Góc trái trên) -->
        <TextView
            android:id="@+id/channelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="8dp"
            android:text="VIỆT NAM"
            android:textColor="#00E5FF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_league_cyan"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp" />

        <!-- Tag LIVE đỏ phẳng (Góc phải trên) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="8dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </FrameLayout>

    <!-- Đường phân cách nhẹ giữa logo và nội dung -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#161820" />

    <!-- Thông tin Kênh & Lịch phát sóng EPG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#0A0B0E">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left|center_vertical"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="VTV1 HD" />

        <TextView
            android:id="@+id/channelSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="left|center_vertical"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Truyền hình Việt Nam" />

        <!-- EPG LIVE CONTAINER -->
        <LinearLayout
            android:id="@+id/epgBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEpgNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Đang tải lịch phát sóng..." />

            <ProgressBar
                android:id="@+id/epgProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="40"
                android:progressTint="#00E5FF" />

            <TextView
                android:id="@+id/tvEpgNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
