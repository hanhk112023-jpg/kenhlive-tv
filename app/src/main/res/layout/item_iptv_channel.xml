<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_iptv_channel_card"
    android:foreground="@drawable/fg_iptv_focus"
    android:paddingLeft="12dp"
    android:paddingRight="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Cụm trái: Logo kênh nền kính đen bóng 16:9 -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:background="#050608"
        android:padding="8dp">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />
    </FrameLayout>

    <!-- Cụm giữa: Tên kênh & Nhóm đài phát -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="VTV1 HD" />

        <TextView
            android:id="@+id/channelSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Việt Nam" />
    </LinearLayout>

    <!-- Cụm phải: Badge nhóm kênh & Dấu hiệu LIVE đỏ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/channelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIỆT NAM"
            android:textColor="#00E5FF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_league_cyan"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

</LinearLayout>
