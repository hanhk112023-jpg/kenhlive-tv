<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:orientation="vertical"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_iptv_channel_card"
    android:foreground="@drawable/fg_iptv_focus"
    android:padding="6dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Cụm trên: Logo Kênh TV + Huy hiệu trạng thái -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@drawable/bg_iptv_card_logo_box"
        android:padding="6dp">

        <!-- Logo Kênh căn giữa -->
        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />

        <!-- Icon Kênh Yêu Thích ở góc trên bên trái -->
        <ImageView
            android:id="@+id/channelFavIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_bookmark_filled"
            android:visibility="gone"
            android:contentDescription="Yêu thích" />

        <!-- Huy hiệu LIVE & HD ở góc trên bên phải -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• LIVE"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_live_red"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="FHD"
                android:textColor="#FFFF6500"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_hd"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Cụm dưới: Tên kênh & Nhóm/Quốc gia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="VTV1 HD" />

        <TextView
            android:id="@+id/channelSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Việt Nam" />
    </LinearLayout>

    <TextView
        android:id="@+id/channelBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>