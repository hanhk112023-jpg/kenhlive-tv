<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kl2_iptv_card_h"
    android:orientation="vertical"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/kl2_channel_card"
    android:foreground="@drawable/fg_iptv_focus"
    android:padding="6dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Cụm trên: Logo Kênh TV hoàn toàn thông thoáng -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_iptv_card_logo_box"
        android:padding="6dp">

        <!-- Logo Kênh căn giữa -->
        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />

        <!-- Icon Kênh Yêu Thích ở góc trên bên trái -->
        <ImageView
            android:id="@+id/channelFavIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:src="@drawable/ic_bookmark_filled"
            android:visibility="gone"
            android:contentDescription="Yêu thích" />
    </RelativeLayout>

    <!-- Cụm dưới: Tên kênh & Nhóm/Quốc gia + Huy hiệu trạng thái -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="VTV1 HD" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/channelSub"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Việt Nam" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• LIVE"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_live_red"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/channelNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text=""
                android:textColor="#FFB300"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_hd"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />
        </LinearLayout>

        <!-- EPG: chương trình đang chiếu THẬT từ nguồn EPG (chỉ kênh có dữ liệu) -->
        <TextView
            android:id="@+id/channelEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#7DD3FC"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/channelBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>