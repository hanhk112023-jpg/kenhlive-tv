<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardIptvRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kl3_channel_card_h"
    android:orientation="vertical"
    android:layout_marginLeft="@dimen/kl3_sp_xs"
    android:layout_marginRight="@dimen/kl3_sp_xs"
    android:layout_marginTop="@dimen/kl3_sp_xs"
    android:layout_marginBottom="@dimen/kl3_sp_xs"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:padding="@dimen/kl3_sp_sm"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Logo kênh — vùng ảnh co giãn, gradient poster KL3 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/kl3_sp_sm"
        android:background="@drawable/kl3i_card_logo_bg">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />

        <!-- Icon kênh yêu thích — huy hiệu vàng góc trái-trên -->
        <ImageView
            android:id="@+id/channelFavIcon"
            android:layout_width="@dimen/kl3_crest_s"
            android:layout_height="@dimen/kl3_crest_s"
            android:layout_gravity="top|left"
            android:layout_margin="@dimen/kl3_sp_xs"
            android:background="@drawable/kl3i_fav_badge"
            android:padding="@dimen/kl3_sp_xs"
            android:src="@drawable/ic_bookmark_filled"
            android:visibility="gone"
            android:contentDescription="Yêu thích" />
    </FrameLayout>

    <!-- Tên kênh -->
    <TextView
        android:id="@+id/channelName"
        style="@style/KL3.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VTV1 HD" />

    <!-- Nhóm + huy hiệu LIVE + số kênh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/kl3_sp_xs">

        <TextView
            android:id="@+id/channelSub"
            style="@style/KL3.Text.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Việt Nam" />

        <TextView
            style="@style/KL3.Badge.Live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textSize="@dimen/kl3_ts_micro" />

        <TextView
            android:id="@+id/channelNum"
            style="@style/KL3.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_xs"
            android:text=""
            android:textColor="@color/kl3_gold"
            android:textSize="@dimen/kl3_ts_micro"
            android:textStyle="bold"
            android:fontFamily="@font/oswald" />
    </LinearLayout>

    <!-- EPG: chương trình đang chiếu thật (chỉ kênh VN có dữ liệu) -->
    <TextView
        android:id="@+id/channelEpg"
        style="@style/KL3.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_xs"
        android:textColor="@color/kl3_info"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Badge nhóm (code bind text; mặc định ẩn) -->
    <TextView
        android:id="@+id/channelBadge"
        style="@style/KL3.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_xs"
        android:textColor="@color/kl3_text_secondary"
        android:textSize="@dimen/kl3_ts_micro"
        android:visibility="gone" />

</LinearLayout>
