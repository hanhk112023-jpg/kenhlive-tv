<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 HOME HUB — cổng chọn 3 hub (Thể thao / Truyền hình / Phim).
     Giữ nguyên mọi android:id (HomeHubFragment bind trực tiếp) và cấu trúc
     LinearLayout.LayoutParams mà applyHubLayout() thao tác (weight + margins). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl3_bg"
    android:descendantFocusability="afterDescendants"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/kl3_margin_x"
    android:paddingRight="@dimen/kl3_margin_x"
    android:paddingTop="@dimen/kl3_gap_l"
    android:paddingBottom="@dimen/kl3_gap_l">

    <!-- 1. TOP HEADER BRAND & CLOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/kl3_gap_l">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_logo_kl"
            android:contentDescription="@string/cd_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/KL3.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KENHLIVE TV"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="@dimen/kl3_dot_live"
                    android:layout_height="@dimen/kl3_dot_live"
                    android:layout_marginLeft="@dimen/kl3_sp_sm"
                    android:background="@drawable/kl3_dot_live" />
            </LinearLayout>

            <TextView
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="CỔNG GIẢI TRÍ TRỰC TUYẾN"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvHubClock"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_pill_bg"
            android:paddingLeft="@dimen/kl3_sp_lg"
            android:paddingRight="@dimen/kl3_sp_lg"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm"
            android:textStyle="bold"
            tools:text="21:45 · Thứ Hai" />
    </LinearLayout>

    <!-- 2. CENTER STAGE: 3 GRAND PORTAL FEATURE CARDS -->
    <LinearLayout
        android:id="@+id/portalContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/kl3_gap"
        android:paddingBottom="@dimen/kl3_gap"
        android:baselineAligned="false">

        <!-- CARD 1: THỂ THAO -->
        <FrameLayout
            android:id="@+id/cardSports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/kl3_rail_gap"
            android:nextFocusRight="@+id/cardIptv"
            android:background="@drawable/kl3s_hub_card_sports"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KL3.Badge.Live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRỰC TIẾP"
                        android:textSize="@dimen/kl3_ts_badge"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:background="@drawable/kl3_pill_bg"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="4 NHÀ ĐÀI"
                        android:textColor="@color/kl3_info" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon: Canva 3D Glowing Football Logo -->
                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:src="@drawable/ic_hub_football"
                    android:layout_marginBottom="@dimen/kl3_gap"
                    android:contentDescription="Thể thao" />

                <!-- Title -->
                <TextView
                    style="@style/KL3.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỂ THAO"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    style="@style/KL3.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_sm"
                    android:text="Trực tiếp bóng đá Socolive, Gà Vàng 33, ColaTV, Giờ Vàng · Lịch thi đấu &amp; Trực tiếp HD"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    style="@style/KL3.Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_gap"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl3_accent" />
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 2: TRUYỀN HÌNH (HUB TRUYỀN HÌNH & M3U TÙY CHỌN) -->
        <FrameLayout
            android:id="@+id/cardIptv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_rail_gap"
            android:layout_marginRight="@dimen/kl3_rail_gap"
            android:visibility="visible"
            android:background="@drawable/kl3s_hub_card_iptv"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/cardSports"
            android:nextFocusRight="@+id/cardPhim"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kl3_pill_bg"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="150+ KÊNH HD"
                        android:textColor="@color/kl3_info" />

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:background="@drawable/kl3_badge_provider"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="M3U TÙY CHỈNH"
                        android:textColor="@color/kl3_info" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon -->
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_nav_tv"
                    android:tint="@color/kl3_info"
                    android:layout_marginBottom="@dimen/kl3_gap"
                    android:contentDescription="Truyền hình" />

                <!-- Title -->
                <TextView
                    style="@style/KL3.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRUYỀN HÌNH"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    style="@style/KL3.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_sm"
                    android:text="Kênh VTV, HTV, VTC, TV360, Thể Thao Quốc Tế &amp; Danh Sách M3U Cá Nhân"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    style="@style/KL3.Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_gap"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl3_info" />
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 3: PHIM TRUYỆN -->
        <FrameLayout
            android:id="@+id/cardPhim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_rail_gap"
            android:nextFocusLeft="@+id/cardIptv"
            android:background="@drawable/kl3s_hub_card_phim"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kl3_badge_hd"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="KHO BOM TẤN"
                        android:textColor="@color/kl3_gold" />

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:background="@drawable/kl3_pill_bg"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="THUYẾT MINH"
                        android:textColor="@color/kl3_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon: Canva 3D Cinema Clapperboard & Reel Logo -->
                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:src="@drawable/ic_hub_cinema"
                    android:layout_marginBottom="@dimen/kl3_gap"
                    android:contentDescription="Phim truyện" />

                <!-- Title -->
                <TextView
                    style="@style/KL3.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHIM TRUYỆN"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    style="@style/KL3.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_sm"
                    android:text="Hơn 33.000+ phim điện ảnh, phim bộ Hàn/Trung/Âu Mỹ, hoạt hình Anime phát trực tiếp HLS 4K"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    style="@style/KL3.Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_gap"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl3_gold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 3. BOTTOM UTILITY & SETTINGS ROW (MỤC 4 & TIỆN ÍCH) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/kl3_gap_l">

        <LinearLayout
            android:id="@+id/btnHubSettings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/kl3_sp_lg"
                android:layout_height="@dimen/kl3_sp_lg"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/kl3_text_secondary"
                android:duplicateParentState="true"
                android:contentDescription="Cài đặt" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="CÀI ĐẶT"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubFeedback"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <!-- Sửa 2026-11-04: icon Telegram trước đây không tint nên giữ màu
                 xanh dương gốc, nhìn như một viền focus xanh riêng, trong khi các
                 nút hub khác đều tint trắng và focus chung bằng pill cam. -->
            <ImageView
                android:layout_width="@dimen/kl3_sp_lg"
                android:layout_height="@dimen/kl3_sp_lg"
                android:src="@drawable/ic_telegram"
                android:tint="@color/kl3_text_secondary"
                android:duplicateParentState="true"
                android:contentDescription="Báo lỗi Telegram" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="BÁO LỖI TELEGRAM"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubMultiview"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="false"
            android:clickable="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/kl3_sp_lg"
                android:layout_height="@dimen/kl3_sp_lg"
                android:src="@drawable/ic_multiview"
                android:tint="@color/kl3_text_secondary"
                android:contentDescription="Đa màn hình" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="XEM ĐA MÀN HÌNH"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubSchedule"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/kl3_sp_lg"
                android:layout_height="@dimen/kl3_sp_lg"
                android:src="@drawable/ic_nav_schedule"
                android:tint="@color/kl3_text_secondary"
                android:duplicateParentState="true"
                android:contentDescription="Lịch thi đấu" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="LỊCH THI ĐẤU"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/kl3_sp_lg"
                android:layout_height="@dimen/kl3_sp_lg"
                android:src="@drawable/ic_nav_search"
                android:tint="@color/kl3_text_secondary"
                android:duplicateParentState="true"
                android:contentDescription="Tìm kiếm" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="TÌM KIẾM"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            style="@style/KL3.Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D-pad · OK chọn · BACK thoát" />
    </LinearLayout>
</LinearLayout>
