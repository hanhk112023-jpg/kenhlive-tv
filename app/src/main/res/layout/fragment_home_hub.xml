<?xml version="1.0" encoding="utf-8"?>
<!-- KL4 HOME HUB — cổng chọn 3 hub (Thể thao / Truyền hình / Phim).
     Thiết kế "Hero portal": mỗi thẻ là 1 hàng ngang — trái là khối chữ
     (badge + title Oswald lớn + mô tả ngắn + hint), phải là một con số/stat
     lớn làm visual anchor bằng chữ (không icon). Mỗi thẻ một accent riêng:
     thể thao = cam, truyền hình = cyan, phim = amber.
     Giữ nguyên mọi android:id mà HomeHubFragment bind (cardSports/cardIptv/
     cardPhim/btnHub*/tvHubClock/portalContainer) + thêm id *Content để
     applyHubLayout() đổi orientation khi điện thoại dọc. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl3_bg"
    android:descendantFocusability="afterDescendants"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/kl3_margin_x"
    android:paddingRight="@dimen/kl3_margin_x"
    android:paddingTop="@dimen/kl3_gap_l"
    android:paddingBottom="@dimen/kl3_gap_l">

    <!-- 1. TOP HEADER BRAND & CLOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/kl3_gap_l">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_logo_kl"
            android:contentDescription="@string/cd_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/KL3.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KENHLIVE TV"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="@dimen/kl3_dot_live"
                    android:layout_height="@dimen/kl3_dot_live"
                    android:layout_marginLeft="@dimen/kl3_sp_sm"
                    android:background="@drawable/kl3_dot_live" />
            </LinearLayout>

            <TextView
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:text="CỔNG GIẢI TRÍ TRỰC TUYẾN"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvHubClock"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_pill_bg"
            android:paddingLeft="@dimen/kl3_sp_lg"
            android:paddingRight="@dimen/kl3_sp_lg"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm"
            android:textStyle="bold"
            tools:text="21:45 · Thứ Hai" />
    </LinearLayout>

    <!-- 2. CENTER STAGE: 3 GRAND PORTAL FEATURE CARDS (layout ngang trong thẻ) -->
    <LinearLayout
        android:id="@+id/portalContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/kl3_gap"
        android:paddingBottom="@dimen/kl3_gap"
        android:baselineAligned="false">

        <!-- CARD 1: THỂ THAO — accent cam -->
        <FrameLayout
            android:id="@+id/cardSports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/kl3_rail_gap"
            android:nextFocusRight="@+id/cardIptv"
            android:background="@drawable/kl3s_hub_card_sports"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:id="@+id/cardSportsContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Trái: khối chữ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KL3.Badge.Live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRỰC TIẾP"
                        android:textSize="@dimen/kl3_ts_badge"
                        android:textStyle="bold"
                        android:letterSpacing="0.07"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        style="@style/KL3.Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="THỂ THAO"
                        android:letterSpacing="0.08" />

                    <TextView
                        style="@style/KL3.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="Trực tiếp bóng đá Socolive, Gà Vàng, ColaTV · Lịch thi đấu 7 ngày · Tỉ số real-time"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        style="@style/KL3.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_gap"
                        android:text="NHẤN OK →"
                        android:textColor="@color/kl3_accent" />
                </LinearLayout>

                <!-- Phải: stat anchor bằng chữ -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginLeft="@dimen/kl3_gap_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="56sp"
                        android:textColor="@color/kl3_accent"
                        android:fontFamily="@font/oswald"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        style="@style/KL3.Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_xs"
                        android:text="NHÀ ĐÀI"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 2: TRUYỀN HÌNH — accent cyan -->
        <FrameLayout
            android:id="@+id/cardIptv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_rail_gap"
            android:layout_marginRight="@dimen/kl3_rail_gap"
            android:visibility="visible"
            android:background="@drawable/kl3s_hub_card_iptv"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/cardSports"
            android:nextFocusRight="@+id/cardPhim"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:id="@+id/cardIptvContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Trái: khối chữ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kl3_pill_bg"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="M3U TÙY CHỈNH"
                        android:textColor="@color/kl3_info" />

                    <TextView
                        style="@style/KL3.Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="TRUYỀN HÌNH"
                        android:letterSpacing="0.08" />

                    <TextView
                        style="@style/KL3.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="Kênh VTV, HTV, VTC, TV360, Thể Thao Quốc Tế &amp; Danh Sách M3U Cá Nhân"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        style="@style/KL3.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_gap"
                        android:text="NHẤN OK →"
                        android:textColor="@color/kl3_info" />
                </LinearLayout>

                <!-- Phải: stat anchor bằng chữ -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginLeft="@dimen/kl3_gap_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150+"
                        android:textSize="56sp"
                        android:textColor="@color/kl3_info"
                        android:fontFamily="@font/oswald"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        style="@style/KL3.Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_xs"
                        android:text="KÊNH HD"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 3: PHIM TRUYỆN — accent amber -->
        <FrameLayout
            android:id="@+id/cardPhim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_rail_gap"
            android:nextFocusLeft="@+id/cardIptv"
            android:background="@drawable/kl3s_hub_card_phim"
            android:foreground="@drawable/kl3_fg_focus"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="@dimen/kl3_sp_xl">

            <LinearLayout
                android:id="@+id/cardPhimContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Trái: khối chữ -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KL3.Text.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kl3_badge_hd"
                        android:paddingLeft="@dimen/kl3_badge_pad_x"
                        android:paddingRight="@dimen/kl3_badge_pad_x"
                        android:paddingTop="@dimen/kl3_sp_xs"
                        android:paddingBottom="@dimen/kl3_sp_xs"
                        android:text="4K FHD"
                        android:textColor="@color/kl3_gold" />

                    <TextView
                        style="@style/KL3.Text.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="PHIM TRUYỆN"
                        android:letterSpacing="0.08" />

                    <TextView
                        style="@style/KL3.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_sm"
                        android:text="Hơn 33.000+ phim điện ảnh, phim bộ Hàn/Trung/Âu Mỹ, hoạt hình Anime — Vietsub &amp; Thuyết minh"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        style="@style/KL3.Text.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_gap"
                        android:text="NHẤN OK →"
                        android:textColor="@color/kl3_gold" />
                </LinearLayout>

                <!-- Phải: stat anchor bằng chữ -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginLeft="@dimen/kl3_gap_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="33K+"
                        android:textSize="56sp"
                        android:textColor="@color/kl3_gold"
                        android:fontFamily="@font/oswald"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        style="@style/KL3.Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/kl3_sp_xs"
                        android:text="PHIM &amp; BỘ"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 3. BOTTOM UTILITY ROW (KL4: chỉ giữ CÀI ĐẶT + BÁO LỖI — Lịch thi đấu &amp;
         Tìm kiếm đã có trên thanh điều hướng chính, bỏ để giảm nút thừa) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/kl3_gap_l">

        <LinearLayout
            android:id="@+id/btnHubSettings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CÀI ĐẶT"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubFeedback"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true">

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BÁO LỖI TELEGRAM"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <!-- TV không có bottom nav -> giữ LỊCH THI ĐẤU / TÌM KIẾM trên Hub (mặc định
             GONE, HomeHubFragment hiện lại khi DeviceMode.isTv). Trên phone đã có
             bottom nav nên ẩn bớt nút thừa. -->
        <LinearLayout
            android:id="@+id/btnHubSchedule"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LỊCH THI ĐẤU"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÌM KIẾM"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubMultiview"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_btn_pad_x"
            android:paddingRight="@dimen/kl3_btn_pad_x"
            android:focusable="false"
            android:clickable="false"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            style="@style/KL3.Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D-pad · OK chọn · BACK thoát" />
    </LinearLayout>
</LinearLayout>
