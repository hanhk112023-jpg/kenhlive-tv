<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl_bg_deep"
    android:descendantFocusability="afterDescendants"
    android:paddingLeft="36dp"
    android:paddingRight="36dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- 1. TOP HEADER BRAND & CLOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_logo_kl"
            android:contentDescription="@string/cd_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/KL.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KENHLIVE TV"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_live_dot" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CỔNG GIẢI TRÍ TRỰC TUYẾN"
                android:textColor="@color/kl_text_3"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvHubClock"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/kl_text_2"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="21:45 · Thứ Hai" />
    </LinearLayout>

    <!-- 2. CENTER STAGE: 3 GRAND PORTAL FEATURE CARDS -->
    <LinearLayout
        android:id="@+id/portalContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- CARD 1: THỂ THAO -->
        <FrameLayout
            android:id="@+id/cardSports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="14dp"
            android:background="@drawable/bg_hub_card_sports"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_live_red"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="TRỰC TIẾP"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="4 NHÀ ĐÀI"
                        android:textColor="@color/kl_brand"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon -->
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_nav_live"
                    android:tint="@color/kl_brand"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Thể thao" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THỂ THAO"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Trực tiếp bóng đá Socolive, Gà Vàng, ColaTV, Khán Đài · Lịch thi đấu &amp; Đa màn hình"
                    android:textColor="@color/kl_text_2"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl_brand"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 2: TRUYỀN HÌNH -->
        <FrameLayout
            android:id="@+id/cardIptv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:background="@drawable/bg_hub_card_iptv"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="150+ KÊNH HD"
                        android:textColor="@color/kl_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="MIỄN PHÍ"
                        android:textColor="@color/kl_text_2"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon -->
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_nav_tv"
                    android:tint="@color/kl_cyan"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Truyền hình" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRUYỀN HÌNH"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Kênh truyền hình VTV, HTV, VTC, K+, Thể thao, Giải trí &amp; Quốc tế trực tuyến"
                    android:textColor="@color/kl_text_2"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- CARD 3: PHIM TRUYỆN -->
        <FrameLayout
            android:id="@+id/cardPhim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:background="@drawable/bg_hub_card_phim"
            android:focusable="true"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="KHO BOM TẤN"
                        android:textColor="@color/kl_amber"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="THUYẾT MINH"
                        android:textColor="@color/kl_text_2"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Icon -->
                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_nav_phim"
                    android:tint="@color/kl_amber"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Phim truyện" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHIM TRUYỆN"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hơn 33.000+ phim điện ảnh, phim bộ Hàn/Trung/Âu Mỹ, hoạt hình Anime chất lượng cao"
                    android:textColor="@color/kl_text_2"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <!-- Footer Hint -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ẤN OK ĐỂ VÀO XEM →"
                    android:textColor="@color/kl_amber"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 3. BOTTOM UTILITY & SETTINGS ROW (MỤC 4 & TIỆN ÍCH) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp">

        <LinearLayout
            android:id="@+id/btnHubSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_hub_pill_btn"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/white"
                android:contentDescription="Cài đặt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="CÀI ĐẶT HỆ THỐNG"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubMultiview"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_hub_pill_btn"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_multiview"
                android:tint="@color/white"
                android:contentDescription="Đa màn hình" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="XEM ĐA MÀN HÌNH"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubSchedule"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_hub_pill_btn"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_schedule"
                android:tint="@color/white"
                android:contentDescription="Lịch thi đấu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="LỊCH THI ĐẤU"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHubSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:background="@drawable/bg_hub_pill_btn"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_nav_search"
                android:tint="@color/white"
                android:contentDescription="Tìm kiếm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="TÌM KIẾM"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điều khiển D-pad · OK chọn · BACK thoát"
            android:textColor="@color/kl_text_3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
