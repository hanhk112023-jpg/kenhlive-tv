<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/room_option_bg"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/avatar_ring">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/avatar_bg">

            <ImageView
                android:id="@+id/roomAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/avatar_mask"
                android:contentDescription="blv" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="11dp">

        <TextView
            android:id="@+id/roomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/oswald"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roomMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8890A6"
            android:textSize="11sp"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <TextView
        android:id="@+id/roomLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="· LIVE"
        android:textColor="#FF3B30"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginRight="4dp" />
</LinearLayout>