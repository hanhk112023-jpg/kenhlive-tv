<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <!-- 6.2.3 ti le chuan: khung hero do theo ti le ANH THAT (listener Coil) —
         cover centerCrop day khung, that bao nhieu lo den day; heroBlur lam day
         khong con den thu. Quyen loi so voi fitCenter (cung het cat nui, thoi den). -->
    <ImageView
        android:id="@+id/heroBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- fitCenter: KHÔNG BAO GIỜ cắt ảnh (promo vnres chữ bake mép); phone tu do
         khung = ti le anh that (listener Coil) nen anh lap day, TV giu khung co
         + heroBlur day hai ben → khong con dai den thuan -->
    <ImageView
        android:id="@+id/heroCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_match" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/heroLeague"
                style="@style/KL.Text.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_brand"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/kl_brand"
                android:maxWidth="260dp"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/heroViewers"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge_glass"
                android:drawableLeft="@drawable/ic_eye"
                android:drawablePadding="6dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/kl_text_1" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroTitle"
            style="@style/KL.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:includeFontPadding="false"
            android:paddingTop="6dp"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <TextView
            android:id="@+id/heroBlv"
            style="@style/KL.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/kl_text_2"
            android:shadowColor="#CC000000"
            android:shadowRadius="6" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/heroPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_button_primary"
                android:paddingLeft="@dimen/btn_pad_x"
                android:paddingRight="@dimen/btn_pad_x"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/cd_play" />

                <TextView
                    style="@style/KL.Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="@string/live_hero_cta"
                    android:textColor="@color/kl_on_brand" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
