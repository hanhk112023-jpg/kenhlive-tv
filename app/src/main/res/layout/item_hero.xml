<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 hero slide — banner trận tâm điểm (HeroPagerAdapter).
     Mọi android:id giữ nguyên; code set text/màu/background động khi bind. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <!-- 16:9 banner cover: fitCenter trên nền đen thuần -->
    <ImageView
        android:id="@+id/heroCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="@string/cd_match" />

    <!-- KL3 cinematic scrim overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/kl3_hero_scrim" />

    <!-- TOP RIGHT: CLOCK & SOLAR/LUNAR DATE WIDGET -->
    <LinearLayout
        android:id="@+id/heroClockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/kl3_gap"
        android:layout_marginRight="@dimen/kl3_margin_x"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/heroClockText"
            style="@style/KL3.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_pill_bg"
            android:paddingLeft="@dimen/kl3_gap"
            android:paddingRight="@dimen/kl3_gap"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_primary"
            android:fontFamily="@font/oswald"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:id="@+id/heroSolarDate"
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kl3_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroLunarDate"
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:textColor="@color/kl3_gold" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT ANCHOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingBottom="@dimen/kl3_sp_xl">

        <!-- Trận đấu tâm điểm, tỷ số & Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Row: LIVE badge + League + Viewers -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/heroLiveBadge"
                    style="@style/KL3.Badge.Live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● TRỰC TIẾP"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/kl3_ts_badge"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/heroLeague"
                    style="@style/KL3.Badge.Provider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/kl3_sp_sm"
                    android:textColor="@color/kl3_info"
                    android:textSize="@dimen/kl3_ts_micro"
                    android:maxWidth="320dp"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/heroViewers"
                    style="@style/KL3.Text.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/kl3_sp_sm"
                    android:background="@drawable/kl3_pill_bg"
                    android:drawableLeft="@drawable/ic_eye"
                    android:drawablePadding="@dimen/kl3_sp_xs"
                    android:paddingLeft="@dimen/kl3_sp_md"
                    android:paddingRight="@dimen/kl3_sp_md"
                    android:paddingTop="@dimen/kl3_sp_xs"
                    android:paddingBottom="@dimen/kl3_sp_xs"
                    android:textColor="@color/kl3_gold"
                    android:fontFamily="@font/oswald"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Arena Match Scoreboard (Logo Đội Nhà | Tỉ số / VS | Logo Đội Khách) -->
            <LinearLayout
                android:id="@+id/heroArenaContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_sm"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/heroHostIcon"
                        android:layout_width="@dimen/kl3_avatar_s"
                        android:layout_height="@dimen/kl3_avatar_s"
                        android:padding="2dp"
                        android:src="@drawable/bg_team_crest_placeholder"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/heroHostName"
                        style="@style/KL3.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_gap"
                        android:maxWidth="280dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:shadowColor="#FF000000"
                        android:shadowDy="2"
                        android:shadowRadius="8" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroScoreText"
                    style="@style/KL3.Badge.Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:minHeight="@dimen/kl3_btn_h_s"
                    android:layout_marginLeft="@dimen/kl3_gap"
                    android:layout_marginRight="@dimen/kl3_gap"
                    android:gravity="center"
                    android:paddingLeft="@dimen/kl3_sp_md"
                    android:paddingRight="@dimen/kl3_sp_md"
                    android:textColor="@color/kl3_gold"
                    android:fontFamily="@font/oswald"
                    android:textSize="@dimen/kl3_ts_title"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:text="VS" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/heroGuestName"
                        style="@style/KL3.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/kl3_gap"
                        android:maxWidth="280dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:shadowColor="#FF000000"
                        android:shadowDy="2"
                        android:shadowRadius="8" />

                    <ImageView
                        android:id="@+id/heroGuestIcon"
                        android:layout_width="@dimen/kl3_avatar_s"
                        android:layout_height="@dimen/kl3_avatar_s"
                        android:padding="2dp"
                        android:src="@drawable/bg_team_crest_placeholder"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Match Title -->
            <TextView
                android:id="@+id/heroTitle"
                style="@style/KL3.Text.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_sm"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:textColor="@color/kl3_text_primary"
                android:shadowColor="#FF000000"
                android:shadowDy="3"
                android:shadowRadius="12" />

            <!-- Commentator / Description Subtitle -->
            <TextView
                android:id="@+id/heroBlv"
                style="@style/KL3.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#E6000000"
                android:shadowDy="2"
                android:shadowRadius="8" />

            <!-- CTA Buttons: Primary + Ghost KL3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_sm"
                android:padding="@dimen/kl3_sp_sm"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Primary CTA: [OK] Xem ngay -->
                <LinearLayout
                    android:id="@+id/heroPlay"
                    android:tag="kl_focus_first"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/kl3_btn_primary"
                    android:foreground="@drawable/kl3_fg_focus_pill"
                    android:minHeight="@dimen/kl3_btn_h"
                    android:paddingLeft="@dimen/kl3_btn_pad_x"
                    android:paddingRight="@dimen/kl3_btn_pad_x"
                    android:paddingTop="@dimen/kl3_sp_md"
                    android:paddingBottom="@dimen/kl3_sp_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusLeft="@id/heroPlay">

                    <ImageView
                        android:layout_width="@dimen/kl3_sp_lg"
                        android:layout_height="@dimen/kl3_sp_lg"
                        android:src="@drawable/ic_play"
                        android:tint="@color/kl3_on_accent"
                        android:contentDescription="@string/cd_play" />

                    <TextView
                        android:id="@+id/heroPlayText"
                        style="@style/KL3.Text.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:text="[OK] Xem ngay" />
                </LinearLayout>

                <!-- Secondary CTA: [MENU] Chi tiết / Đổi luồng -->
                <LinearLayout
                    android:id="@+id/heroDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/kl3_gap"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/kl3_btn_ghost"
                    android:foreground="@drawable/kl3_fg_focus_pill"
                    android:minHeight="@dimen/kl3_btn_h"
                    android:paddingLeft="@dimen/kl3_btn_pad_x"
                    android:paddingRight="@dimen/kl3_btn_pad_x"
                    android:paddingTop="@dimen/kl3_sp_md"
                    android:paddingBottom="@dimen/kl3_sp_md"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/kl3_sp_lg"
                        android:layout_height="@dimen/kl3_sp_lg"
                        android:src="@drawable/ic_info"
                        android:tint="@color/kl3_text_primary"
                        android:contentDescription="Chi tiết" />

                    <TextView
                        style="@style/KL3.Text.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:text="[MENU] Đổi Luồng"
                        android:textColor="@color/kl3_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
