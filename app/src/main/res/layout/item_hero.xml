<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <ImageView
        android:id="@+id/heroCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <!-- overlay text trai, day -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingBottom="34dp">

        <!-- chip giai dau -->
        <TextView
            android:id="@+id/heroLeague"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:fontFamily="sans-serif-black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:background="@drawable/pill_glass"
            android:paddingLeft="10dp" android:paddingRight="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:shadowColor="#E6000000" android:shadowRadius="6" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="240dp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/oswald"
            android:textSize="44sp"
            android:textStyle="bold"
            android:minLines="2"
            android:letterSpacing="0.01"
            android:shadowColor="#E6000000"
            android:shadowDy="3"
            android:shadowRadius="12"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/heroBlv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="240dp"
            android:textColor="#F1F5F9"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp"
            android:shadowColor="#CC000000" android:shadowRadius="6"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/heroTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginRight="240dp"
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            android:shadowColor="#CC000000" android:shadowRadius="6"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CTA: play tron + chu -->
            <LinearLayout
                android:id="@+id/heroPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_hero_play"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play_triangle"
                    android:contentDescription="play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="XEM NGAY"
                    android:textColor="#04140B"
                    android:fontFamily="@font/oswald"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroViewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/oswald"
                android:textSize="18sp"
                android:shadowColor="#CC000000" android:shadowRadius="6"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
