<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <ImageView
        android:id="@+id/heroCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <!-- overlay text trái, đáy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/heroLeague"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4A40"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginRight="220dp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/oswald"
            android:textSize="34sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/heroBlv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="220dp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/heroTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="220dp"
            android:textColor="#D0D0D0"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CTA chính: Xem ngay -->
            <LinearLayout
                android:id="@+id/heroPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_hero_play"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play_triangle"
                    android:contentDescription="play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="XEM NGAY"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/oswald"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <!-- meta: viewers · N phòng -->
            <TextView
                android:id="@+id/heroViewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/oswald"
                android:textSize="17sp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>