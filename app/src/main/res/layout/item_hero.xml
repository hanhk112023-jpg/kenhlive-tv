<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <!-- 16:9 banner cover: fitCenter trên nền đen thuần #000000 -->
    <ImageView
        android:id="@+id/heroCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="@string/cd_match" />

    <!-- Cinematic scrim overlay (Gradient đen tuyền Apple TV / Netflix) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- TOP RIGHT: CLOCK & SOLAR/LUNAR DATE WIDGET (Pill đen bo góc) -->
    <LinearLayout
        android:id="@+id/heroClockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/sp_screen_margin"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/heroClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clock_pill"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/oswald" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:id="@+id/heroSolarDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kl_text_1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroLunarDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/kl_amber"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT ANCHOR (Đáy Hero: Badge, Title lớn, BLV, CTA Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingBottom="@dimen/hero_pad_b">

        <!-- Header Row: LIVE badge RED + Tournament/League Cyan + Viewers -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/heroLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:background="@drawable/bg_badge_live_red"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/heroLeague"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_badge_league_cyan"
                android:textColor="@color/kl_brand"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:maxWidth="320dp"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/heroViewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_score_pill"
                android:drawableLeft="@drawable/ic_eye"
                android:drawablePadding="6dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/kl_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/oswald" />
        </LinearLayout>

        <!-- Match Title: Đậm, to rõ phong cách Netflix Showcase -->
        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="40dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDy="3"
            android:shadowRadius="12" />

        <!-- Commentator / Description Subtitle -->
        <TextView
            android:id="@+id/heroBlv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/kl_text_2"
            android:textSize="14sp"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <!-- CTA Buttons: Apple TV Minimalist Focusable Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Primary CTA: Xem ngay (Apple TV Primary Pill) -->
            <LinearLayout
                android:id="@+id/heroPlay"
                android:tag="kl_focus_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_hero_btn_watch"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/cd_play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Xem ngay"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Secondary CTA: Chi tiết (Apple TV Secondary Dark Pill) -->
            <LinearLayout
                android:id="@+id/heroDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_hero_btn_details"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_info"
                    android:contentDescription="Chi tiết" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="Chi tiết"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
