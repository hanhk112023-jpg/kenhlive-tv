        <!-- Header: League badge + Viewers badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/heroLeague"
                style="@style/KL.Text.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_brand"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/kl_brand"
                android:maxWidth="260dp"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/heroViewers"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge_glass"
                android:drawableLeft="@drawable/ic_eye"
                android:drawablePadding="6dp"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/kl_text_1" />
        </LinearLayout>

        <!-- Match Title -->
        <TextView
            android:id="@+id/heroTitle"
            style="@style/KL.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:shadowColor="#FF000000"
            android:shadowDy="3"
            android:shadowRadius="12" />

        <!-- Commentator Subtitle -->
        <TextView
            android:id="@+id/heroBlv"
            style="@style/KL.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/kl_text_2"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <!-- CTA Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/heroPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_button_primary"
                android:paddingLeft="@dimen/btn_pad_x"
                android:paddingRight="@dimen/btn_pad_x"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/cd_play" />

                <TextView
                    style="@style/KL.Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="9dp"
                    android:text="@string/live_hero_cta"
                    android:textColor="@color/kl_on_brand" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
