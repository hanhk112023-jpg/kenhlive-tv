<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg"
    android:keepScreenOn="true">

    <!-- WebView Host Container (An toàn chống crash khi thiết bị thiếu WebView) -->
    <FrameLayout
        android:id="@+id/webViewHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/playerLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/kl3_accent"
        android:indeterminate="true" />

    <!-- Custom Web Fullscreen View Container (HTML5 Fullscreen) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kl3_bg"
        android:visibility="gone" />

    <!-- Player Top OSD Overlay (Tự ẩn sau 3.5s) -->
    <LinearLayout
        android:id="@+id/playerTopOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/kl3p_scrim_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_md">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/KL3.Button.Icon"
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/player_back"
            android:focusable="true"
            android:nextFocusDown="@id/btnWebPlayPause" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFilmTitle"
                style="@style/KL3.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/kl3_ts_body_lg"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/tvEpisodeTitle"
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:textColor="@color/kl3_accent_bright"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTechBadge"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:text="STREAMC HD"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.07" />
    </LinearLayout>

    <!-- Thanh điều khiển dưới cho trình phát web: cụm nút kính bo 14dp, focus viền cam.
         Hiện cùng lúc với OSD trên, tự ẩn sau 3.5s. -->
    <LinearLayout
        android:id="@+id/webControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/kl3p_scrim_bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_xl"
        android:visibility="gone">

        <Button
            android:id="@+id/btnWebPrevEp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:text="◀ Tập trước"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebSeekBack"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:text="◀◀ -10s"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <ImageButton
            android:id="@+id/btnWebPlayPause"
            style="@style/KL3.Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="@dimen/kl3_sp_xl"
            android:layout_marginRight="@dimen/kl3_sp_xl"
            android:src="@drawable/ic_pause"
            android:contentDescription="Phát/Tạm dừng"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebSeekFwd"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:text="+10s ▶▶"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebNextEp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:text="Tập tiếp ▶"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebEpisodes"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:text="Danh sách tập"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />
    </LinearLayout>

    <!-- Màn hình lỗi tải trang embed (H2): chỉ hiện khi lỗi ở khung hình chính
         (mất mạng / HTTP 4xx-5xx / SSL). Lỗi tài nguyên phụ không hiện hộp này.
         clickable+focusable để chặn chạm/focus xuyên xuống WebView bên dưới. -->
    <LinearLayout
        android:id="@+id/webErrorBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kl3_scrim_85"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWebError"
            style="@style/KL3.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="580dp"
            android:text="Không tải được trang phát phim."
            android:textSize="@dimen/kl3_ts_body_lg"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWebRetry"
                style="@style/KL3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thử lại"
                android:textColor="@color/kl3_on_accent"
                android:textSize="@dimen/kl3_ts_body"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:maxLines="1"
                android:nextFocusRight="@id/btnWebErrorBack" />

            <Button
                android:id="@+id/btnWebErrorBack"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="Quay lại"
                android:nextFocusLeft="@id/btnWebRetry" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
