<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- WebView Host Container (An toàn chống crash khi thiết bị thiếu WebView) -->
    <FrameLayout
        android:id="@+id/webViewHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/playerLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:indeterminate="true" />

    <!-- Custom Web Fullscreen View Container (HTML5 Fullscreen) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Player Top OSD Overlay (Tự ẩn sau 3.5s) -->
    <LinearLayout
        android:id="@+id/playerTopOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_overlay_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/KL.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/player_back"
            android:focusable="true"
            android:nextFocusDown="@id/btnWebPlayPause" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFilmTitle"
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvEpisodeTitle"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/kl_brand"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTechBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_hd"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="STREAMC HD"
            android:textSize="11sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Thanh điều khiển dưới cho trình phát web: Tua -10s / Play-Pause / Tua +10s.
         Hiện cùng lúc với OSD trên, tự ẩn sau 3.5s. -->
    <LinearLayout
        android:id="@+id/webControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_overlay_bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnWebPrevEp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_choice_chip"
            android:text="◀ Tập trước"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebSeekBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_dialog_choice_chip"
            android:text="◀◀  -10s"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <ImageButton
            android:id="@+id/btnWebPlayPause"
            style="@style/KL.IconButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="22dp"
            android:layout_marginRight="22dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="Phát/Tạm dừng"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebSeekFwd"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_choice_chip"
            android:text="+10s  ▶▶"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebNextEp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_dialog_choice_chip"
            android:text="Tập tiếp ▶"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />

        <Button
            android:id="@+id/btnWebEpisodes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_dialog_choice_chip"
            android:text="Danh sách tập"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:focusable="true"
            android:nextFocusUp="@id/btnBack" />
    </LinearLayout>

    <!-- Màn hình lỗi tải trang embed (H2): chỉ hiện khi lỗi ở khung hình chính
         (mất mạng / HTTP 4xx-5xx / SSL). Lỗi tài nguyên phụ không hiện hộp này.
         clickable+focusable để chặn chạm/focus xuyên xuống WebView bên dưới. -->
    <LinearLayout
        android:id="@+id/webErrorBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWebError"
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="580dp"
            android:text="Không tải được trang phát phim."
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWebRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_choice_chip"
                android:focusable="true"
                android:nextFocusRight="@id/btnWebErrorBack"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="Thử lại"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWebErrorBack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_dialog_choice_chip"
                android:focusable="true"
                android:nextFocusLeft="@id/btnWebRetry"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="Quay lại"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
