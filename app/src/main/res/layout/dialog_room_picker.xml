<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog chon phong BLV / doi tran — D-pad friendly (RecyclerView focusable) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kl3p_dialog_bg"
    android:paddingLeft="@dimen/kl3_sp_xl"
    android:paddingRight="@dimen/kl3_sp_xl"
    android:paddingTop="@dimen/kl3_sp_xl"
    android:paddingBottom="@dimen/kl3_sp_lg">

    <!-- Tiêu đề kèm thanh nhấn accent KL3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="@dimen/kl3_section_bar_w"
            android:layout_height="22dp"
            android:background="@color/kl3_accent"
            android:layout_marginRight="@dimen/kl3_gap" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogTitle"
                style="@style/KL3.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/dialogLeague"
                style="@style/KL3.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kl3_accent_bright"
                android:layout_marginTop="@dimen/kl3_sp_xs" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_divider_h"
        android:layout_marginTop="@dimen/kl3_sp_lg"
        android:layout_marginBottom="@dimen/kl3_gap"
        android:background="@drawable/kl3_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/kl3_sp_xxl"
        android:scrollbars="vertical" />
</LinearLayout>
