<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog chon phong BLV / doi tran — D-pad friendly (RecyclerView focusable) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/kl2_dialog_bg"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="22dp"
    android:paddingBottom="16dp">

    <!-- Tiêu đề kèm thanh nhấn chuyển sắc kl2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:background="@drawable/kl2_section_bar"
            android:layout_marginRight="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogTitle"
                style="@style/KL.Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/dialogLeague"
                style="@style/KL.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kl_brand"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/kl_border_soft" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        android:scrollbars="vertical" />
</LinearLayout>
