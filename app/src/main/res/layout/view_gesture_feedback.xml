<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestureFeedbackBox"
    android:layout_width="140dp"
    android:layout_height="140dp"
    android:layout_gravity="center"
    android:background="@drawable/kl3p_glass_panel"
    android:elevation="@dimen/kl3_elev_3"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/kl3_sp_lg"
    android:visibility="gone">

    <ImageView
        android:id="@+id/gestureIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_audio"
        android:tint="@color/kl3_accent" />

    <ProgressBar
        android:id="@+id/gestureProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="90dp"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/kl3_gap"
        android:max="100"
        android:progress="50"
        android:progressTint="@color/kl3_accent"
        android:progressDrawable="@drawable/bg_progress_horizontal" />

    <TextView
        android:id="@+id/gestureText"
        style="@style/KL3.Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_sm"
        android:fontFeatureSettings="tnum"
        android:textStyle="bold"
        android:text="50%" />
</LinearLayout>
