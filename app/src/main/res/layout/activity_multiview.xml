<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/mvGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mvRow0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="2"
            android:baselineAligned="false">

            <include layout="@layout/item_multiview_cell" android:id="@+id/slot0"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include layout="@layout/item_multiview_cell" android:id="@+id/slot1"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mvRow1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false"
            android:visibility="gone">

            <include layout="@layout/item_multiview_cell" android:id="@+id/slot2"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_multiview_cell" android:id="@+id/slot3"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM BAR OVERLAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kl3p_scrim_bottom"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingTop="@dimen/kl3_sp_xl"
        android:paddingBottom="@dimen/kl3_sp_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/KL3.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mv_title" />

            <TextView
                android:id="@+id/hintText"
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:textColor="@color/kl3_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="600dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/layoutBtn"
            style="@style/KL3.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm" />
    </LinearLayout>

    <!-- Trạng thái rỗng TRUNG THỰC khi không có trận live thật (thay cho danh sách
         trận mẫu bịa trước đây). clickable+focusable để chặn chạm xuyên xuống các ô. -->
    <LinearLayout
        android:id="@+id/mvEmptyBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kl3_scrim_85"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/KL3.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/kl3_ts_body_lg"
            android:textStyle="bold"
            android:text="Hiện chưa có trận đấu nào đang trực tiếp" />

        <TextView
            style="@style/KL3.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:gravity="center"
            android:maxWidth="520dp"
            android:text="Danh sách trận sẽ có khi các trận bắt đầu. Bấm Thử lại để kiểm tra lại." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMvRetry"
                style="@style/KL3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thử lại"
                android:textColor="@color/kl3_on_accent"
                android:textSize="@dimen/kl3_ts_body"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:maxLines="1"
                android:nextFocusRight="@id/btnMvBack" />

            <Button
                android:id="@+id/btnMvBack"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="Quay lại"
                android:nextFocusLeft="@id/btnMvRetry" />
        </LinearLayout>
    </LinearLayout>

    <!-- Focus border placed at the very end of FrameLayout to ensure it is always above overlays -->
    <View
        android:id="@+id/focusBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp" />
</FrameLayout>
