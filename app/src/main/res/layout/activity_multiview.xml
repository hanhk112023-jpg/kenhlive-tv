<?xml version="1.0" encoding="utf-8"?>
<!-- Multiview: 2 (trái/phải) ⇄ 4 (2x2) — hàng dưới (row1) bật/tắt theo layout.
     Hint bar overlay; focusBorder vẽ trên cùng. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/mvGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mvRow0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="2"
            android:baselineAligned="false">

            <include
                android:id="@+id/slot0"
                layout="@layout/item_multiview_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/slot1"
                layout="@layout/item_multiview_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mvRow1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false"
            android:visibility="gone">

            <include
                android:id="@+id/slot2"
                layout="@layout/item_multiview_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <include
                android:id="@+id/slot3"
                layout="@layout/item_multiview_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thanh hint overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#B3000000"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◫ MULTIVIEW"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/oswald"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/hintText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="điều hướng: chọn ô · OK: đổi trận · MENU: hoán đổi · BACK: thoát"
            android:textColor="#CFCFCF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/layoutBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bố cục: 2"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_glass_flat"
            android:paddingLeft="13dp"
            android:paddingRight="13dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Khung viền focus vẽ TRÊN CÙNG → đè hint bar, cạnh trên không bị che. -->
    <View
        android:id="@+id/focusBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</FrameLayout>
