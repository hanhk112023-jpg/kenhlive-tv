<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl_bg_deep"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/mvGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mvRow0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="2"
            android:baselineAligned="false">

            <include layout="@layout/item_multiview_cell" android:id="@+id/slot0"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include layout="@layout/item_multiview_cell" android:id="@+id/slot1"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mvRow1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="2"
            android:baselineAligned="false"
            android:visibility="gone">

            <include layout="@layout/item_multiview_cell" android:id="@+id/slot2"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <include layout="@layout/item_multiview_cell" android:id="@+id/slot3"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM BAR OVERLAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_overlay_bottom"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mv_title" />

            <TextView
                android:id="@+id/hintText"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#CBD5E1"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="600dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/layoutBtn"
            style="@style/KL.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Trạng thái rỗng TRUNG THỰC khi không có trận live thật (thay cho danh sách
         trận mẫu bịa trước đây). clickable+focusable để chặn chạm xuyên xuống các ô. -->
    <LinearLayout
        android:id="@+id/mvEmptyBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Hiện chưa có trận đấu nào đang trực tiếp" />

        <TextView
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Danh sách trận sẽ có khi các trận bắt đầu. Bấm Thử lại để kiểm tra lại."
            android:textColor="#CBD5E1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMvRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_choice_chip"
                android:focusable="true"
                android:nextFocusRight="@id/btnMvBack"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="Thử lại"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMvBack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_dialog_choice_chip"
                android:focusable="true"
                android:nextFocusLeft="@id/btnMvRetry"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="Quay lại"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Focus border placed at the very end of FrameLayout to ensure it is always above overlays -->
    <View
        android:id="@+id/focusBorder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp" />
</FrameLayout>
