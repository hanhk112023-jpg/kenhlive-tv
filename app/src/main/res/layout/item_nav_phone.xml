<?xml version="1.0" encoding="utf-8"?>
<!-- KL4 bottom-nav item (phone) — TEXT ONLY, không icon.
     Selected state driven by MainActivity (v.isSelected):
     text accent (kl3_nav_text) + gạch chân accent (kl3_nav_underline). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginLeft="@dimen/kl3_sp_xs"
    android:layout_marginRight="@dimen/kl3_sp_xs"
    android:layout_marginTop="@dimen/kl3_sp_xs"
    android:layout_marginBottom="@dimen/kl3_sp_xs"
    android:background="@drawable/kl3_nav_item_bg"
    android:foreground="@drawable/kl3_fg_focus_pill"
    android:paddingTop="@dimen/kl3_sp_xs"
    android:paddingBottom="@dimen/kl3_sp_xs"
    android:clickable="true"
    android:focusable="false">

    <TextView
        android:id="@+id/navLabel"
        style="@style/KL3.Text.Nav"
        android:textColor="@color/kl3_nav_text"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/kl3_sp_xs"
        android:background="@drawable/kl3_nav_underline"
        android:duplicateParentState="true" />
</LinearLayout>
