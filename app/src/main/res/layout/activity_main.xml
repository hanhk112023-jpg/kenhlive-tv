<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- TOP BAR chuẩn TV: logo + wordmark | tab text underline | live chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="KênhLive"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/oswald"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <Space android:layout_width="36dp" android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/nav_live"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/tab_underline_bg"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRỰC TIẾP"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/oswald"
                android:letterSpacing="0.08"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_schedule"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/tab_underline_bg"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LỊCH TRÌNH"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/oswald"
                android:letterSpacing="0.08"
                android:textColor="#CFCFCF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@drawable/tab_underline_bg"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tv_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÌM KIẾM"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/oswald"
                android:letterSpacing="0.08"
                android:textColor="#CFCFCF" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/countText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DCDCDC"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>