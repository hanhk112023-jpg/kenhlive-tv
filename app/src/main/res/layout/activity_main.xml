<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl3_bg">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kl3_topbar_bg"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:visibility="gone">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logo_kl"
            android:contentDescription="@string/cd_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/KL3.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="@dimen/kl3_dot_live"
                android:layout_height="@dimen/kl3_dot_live"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:background="@drawable/kl3_dot_live" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/countText"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_pill_bg"
            android:paddingLeft="@dimen/kl3_sp_md"
            android:paddingRight="@dimen/kl3_sp_md"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_accent"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="160dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnTopRefresh"
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:background="@drawable/kl3_btn_icon"
            android:padding="@dimen/kl3_sp_md"
            android:scaleType="centerInside"
            android:tint="@color/kl3_icon_tint"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Làm mới" />

        <ImageButton
            android:id="@+id/btnTopSettings"
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:background="@drawable/kl3_btn_icon"
            android:padding="@dimen/kl3_sp_md"
            android:scaleType="centerInside"
            android:tint="@color/kl3_icon_tint"
            android:src="@drawable/ic_nav_settings"
            android:contentDescription="@string/nav_settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTTOM NAVIGATION (5 Tabs Ergonomics) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottomnav_h"
        android:orientation="horizontal"
        android:background="@drawable/kl3s_bottomnav_bg"
        android:paddingLeft="@dimen/kl3_sp_xs"
        android:paddingRight="@dimen/kl3_sp_xs"
        android:baselineAligned="false"
        android:visibility="gone">

        <include layout="@layout/item_nav_phone" android:id="@+id/nav_live" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_iptv" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_phim" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_schedule" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_search" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_settings" />
    </LinearLayout>
</LinearLayout>
