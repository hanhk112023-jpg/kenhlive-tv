<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl_bg_deep">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_h"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_topbar"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_logo_kl"
            android:contentDescription="@string/cd_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="17sp"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginLeft="7dp"
                android:background="@drawable/bg_live_dot" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/countText"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/kl_brand"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="160dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottomnav_h"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottomnav"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:baselineAligned="false">

        <include layout="@layout/item_nav_phone" android:id="@+id/nav_live" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_schedule" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_search" />
        <include layout="@layout/item_nav_phone" android:id="@+id/nav_settings" />
    </LinearLayout>
</LinearLayout>
