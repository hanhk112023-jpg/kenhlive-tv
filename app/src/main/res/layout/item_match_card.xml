<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/sp_card_gap"
    android:background="@drawable/bg_card"
    android:foreground="@drawable/fg_focus"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: tag giai (trai) + LIVE pill DO (phai) — nguyen mau card bong da FPT Play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardLeague"
            style="@style/KL.Text.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/kl_text_3"
            android:textSize="@dimen/ts_fx_meta"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/ts_fx_team"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Row 2: ten doi trai | giua: viewers | ten doi phai -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="52dp">

        <TextView
            android:id="@+id/cardHost"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="@color/kl_text_1"
            android:textSize="@dimen/ts_fx_team"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="62dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <ImageView
                android:id="@+id/cardAvatar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cardViewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#FF4D4D"
                android:fontFamily="@font/oswald"
                android:textSize="@dimen/ts_card_room"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardGuest"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:textColor="@color/kl_text_1"
            android:textSize="@dimen/ts_fx_team"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Row 3: BLV + so phong -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardBlv"
            style="@style/KL.Text.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#DCE6F0"
            android:textSize="@dimen/ts_fx_meta"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/pill_glass"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- day bar cam nhan: match live co vat trang mong o day (nhip FPT) -->
    <View
        android:id="@+id/cardAccent"
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_accent_live" />
</LinearLayout>
