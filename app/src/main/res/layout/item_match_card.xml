<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/sp_card_gap"
    android:background="@drawable/bg_card_match"
    android:foreground="@drawable/fg_card_focus_cyan"
    android:padding="14dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: League tag (left) + Provider tag + LIVE pill RED (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardLeague"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_league_cyan"
            android:textColor="@color/kl_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_badge_brand"
            android:textColor="#FBBF24"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:maxLines="1"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cardLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Row 2: Trung tâm trận đấu (FotMob / Stadium Style: Team Host | Score Board | Team Guest) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="62dp">

        <!-- Đội nhà (Host) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/cardHost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-semibold"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/cardHostIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:padding="2dp"
                android:src="@drawable/bg_team_crest_placeholder"
                android:visibility="visible"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Tâm điểm: Bảng Tỉ số sân vận động / VS to rõ chuẩn 4K TV -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/cardScore"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/bg_score_pill"
                android:textColor="#FFFFFF"
                android:text="VS"
                android:fontFamily="@font/oswald"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Đội khách (Guest) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <ImageView
                android:id="@+id/cardGuestIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginRight="8dp"
                android:padding="2dp"
                android:src="@drawable/bg_team_crest_placeholder"
                android:visibility="visible"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cardGuest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-semibold"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Đường chia hairline mờ thanh thoát -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#151A24" />

    <!-- Row 3: Meta info chuẩn: Avatar BLV tròn + Tên BLV + Lượt xem + Phòng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cardAvatar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="7dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/cardBlv"
            style="@style/KL.Text.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#CBD5E1"
            android:textSize="11.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#FBBF24"
            android:fontFamily="@font/oswald"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="#38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/room_badge_bg"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ẩn các trường tương thích cũ không làm vỡ code Kotlin -->
    <TextView
        android:id="@+id/cardMatchTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
