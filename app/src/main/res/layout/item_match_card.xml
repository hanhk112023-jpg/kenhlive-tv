<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 match card — trận ĐANG DIỄN RA (MatchCardsAdapter TYPE_LIVE).
     3 tầng: badges → đội + score pill → meta (BLV/viewers/phòng).
     Mọi android:id giữ nguyên; code set width + màu động khi bind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/kl3_match_card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/kl3_rail_gap"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:padding="@dimen/kl3_card_h_pad"
    android:elevation="@dimen/kl3_elev_1"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: League tag (left) + Provider tag + time badge + LIVE pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardLeague"
            style="@style/KL3.Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_pill_bg"
            android:textColor="@color/kl3_text_secondary"
            android:paddingLeft="@dimen/kl3_badge_pad_x"
            android:paddingRight="@dimen/kl3_badge_pad_x"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_xs"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardProvider"
            style="@style/KL3.Badge.Provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:textColor="@color/kl3_info"
            android:textSize="@dimen/kl3_ts_micro"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cardTimeBadge"
            style="@style/KL3.Badge.Soon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/kl3_sp_sm"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/kl3_ts_micro"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cardLive"
            style="@style/KL3.Badge.Live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none" />
    </LinearLayout>

    <!-- Row 2: Host | Score pill | Guest -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="62dp">

        <!-- Đội nhà (Host) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/cardHost"
                style="@style/KL3.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/kl3_text_primary"
                android:maxLines="1"
                android:singleLine="true"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/cardHostIcon"
                android:layout_width="@dimen/kl3_crest_s"
                android:layout_height="@dimen/kl3_crest_s"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:padding="2dp"
                android:src="@drawable/bg_team_crest_placeholder"
                android:visibility="visible"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Tâm điểm: Bảng Tỉ số / VS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="@dimen/kl3_sp_sm"
            android:paddingRight="@dimen/kl3_sp_sm">

            <TextView
                android:id="@+id/cardScore"
                style="@style/KL3.Badge.Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="@dimen/kl3_chip_h"
                android:gravity="center"
                android:paddingLeft="@dimen/kl3_sp_sm"
                android:paddingRight="@dimen/kl3_sp_sm"
                android:text="VS"
                android:textSize="@dimen/kl3_ts_title"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Đội khách (Guest) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <ImageView
                android:id="@+id/cardGuestIcon"
                android:layout_width="@dimen/kl3_crest_s"
                android:layout_height="@dimen/kl3_crest_s"
                android:layout_marginRight="@dimen/kl3_sp_sm"
                android:padding="2dp"
                android:src="@drawable/bg_team_crest_placeholder"
                android:visibility="visible"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cardGuest"
                style="@style/KL3.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/kl3_text_primary"
                android:maxLines="1"
                android:singleLine="true"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_divider_h"
        android:layout_marginTop="@dimen/kl3_gap"
        android:layout_marginBottom="@dimen/kl3_sp_sm"
        android:background="@drawable/kl3_divider" />

    <!-- Row 3: Meta — Avatar BLV + Tên BLV + Viewers + Phòng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/cardAvatar"
            android:layout_width="@dimen/kl3_avatar_s"
            android:layout_height="@dimen/kl3_avatar_s"
            android:layout_marginRight="@dimen/kl3_sp_sm"
            android:background="@drawable/kl3s_avatar_circle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/cardBlv"
            style="@style/KL3.Text.Body"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/kl3_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardViewers"
            style="@style/KL3.Text.Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:textSize="@dimen/kl3_ts_meta" />

        <TextView
            android:id="@+id/cardRooms"
            style="@style/KL3.Badge.Provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:textColor="@color/kl3_info"
            android:textSize="@dimen/kl3_ts_micro"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ẩn các trường tương thích cũ không làm vỡ code Kotlin -->
    <TextView
        android:id="@+id/cardMatchTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
