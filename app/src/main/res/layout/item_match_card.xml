<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="@dimen/card_w"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="@dimen/sp_card_gap"
    android:background="@drawable/bg_card_match"
    android:foreground="@drawable/fg_card_focus_cyan"
    android:padding="14dp"
    android:focusable="true"
    android:clickable="true">

    <!-- Row 1: League tag (left) + LIVE pill RED (right) (kieu IMG_2815) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardLeague"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_league_cyan"
            android:textColor="@color/kl_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:ellipsize="end" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cardLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Row 2: Doi nha (trai) | Giua: Ti so 0:0 hoac Avatar BLV | Doi khach (phai) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="54dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:id="@+id/cardHost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/kl_text_1"
                android:textSize="@dimen/ts_fx_team"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/cardHostIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_sports"
                android:visibility="gone"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Center badge: VS badge tron dong bo (kieu IMG_2815) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/cardScore"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_vs_circle"
                android:textColor="#FFFFFF"
                android:text="VS"
                android:fontFamily="@font/oswald"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/cardAvatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <ImageView
                android:id="@+id/cardGuestIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/ic_sports"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cardGuest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textColor="@color/kl_text_1"
                android:textSize="@dimen/ts_fx_team"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:breakStrategy="simple"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Tên trận đấu đầy đủ (kieu IMG_2815) -->
    <TextView
        android:id="@+id/cardMatchTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/kl_text_1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Row 4: BLV + Viewers / Thời gian bắt đầu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardBlv"
            style="@style/KL.Text.Meta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/kl_text_2"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/kl_amber"
            android:fontFamily="@font/oswald"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textColor="@color/kl_text_2"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
