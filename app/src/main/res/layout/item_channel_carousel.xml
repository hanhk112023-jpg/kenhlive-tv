<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="104dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card_match"
    android:foreground="@drawable/fg_card_focus_cyan"
    android:focusable="true"
    android:clickable="true"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Cụm trên: Logo & Số kênh (Pure Black Background) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/carouselNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_league_cyan"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="01" />

        <ImageView
            android:id="@+id/carouselLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_tv" />
    </RelativeLayout>

    <!-- Đường kẻ hairline chuẩn Pure Black -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1F29" />

    <!-- Cụm dưới: Tên kênh & Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/carouselName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="VTV1 HD" />

        <TextView
            android:id="@+id/carouselSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8E9AA8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Thời sự 19h" />
    </LinearLayout>

</LinearLayout>
