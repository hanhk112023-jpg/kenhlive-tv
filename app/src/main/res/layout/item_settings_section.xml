<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/kl3_gap_l"
    android:paddingBottom="@dimen/kl3_sp_sm">

    <!-- Accent bar 4dp theo spec KL3 section header -->
    <View
        android:layout_width="@dimen/kl3_section_bar_w"
        android:layout_height="@dimen/kl3_sp_lg"
        android:background="@color/kl3_accent"
        android:layout_marginRight="@dimen/kl3_sp_md" />

    <TextView
        android:id="@+id/sectionTitle"
        style="@style/KL3.Text.Section"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06" />
</LinearLayout>
