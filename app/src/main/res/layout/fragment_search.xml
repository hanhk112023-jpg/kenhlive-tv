<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/searchInput"
            style="@style/KL.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:drawableLeft="@drawable/ic_nav_search"
            android:drawableTint="@color/kl_text_3"
            android:nextFocusDown="@+id/resultList" />

        <ImageButton
            android:id="@+id/clearBtn"
            style="@style/KL.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/search_clear" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/resultCount"
        style="@style/KL.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sp_screen_margin"
        android:layout_marginBottom="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/sp_screen_margin"
            android:paddingRight="@dimen/sp_screen_margin"
            android:paddingBottom="@dimen/sp_row_gap"
            android:scrollbars="vertical" />

        <include layout="@layout/view_state" />
    </FrameLayout>
</LinearLayout>
