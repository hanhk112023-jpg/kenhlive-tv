<?xml version="1.0" encoding="utf-8"?>
<!-- HERO PHIM — KL3 redesign: full-bleed backdrop + kl3_hero_scrim,
     nội dung neo cạnh dưới, CTA theo chuẩn KL3 (1 Primary + Ghost).
     Nút Về trang chủ là icon-button kính nổi góc trái.
     Mọi android:id giữ nguyên (bind trong PhimFragment.HeroVH). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kl3_hero_h"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_marginBottom="@dimen/kl3_sp_sm"
    android:background="@color/kl3_bg_soft">

    <!-- 1. Backdrop full-bleed -->
    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Phim nổi bật" />

    <!-- 2. Scrim KL3 (đáy + trái) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/kl3_hero_scrim" />

    <!-- 3. Nút Về trang chủ: icon-button kính KL3, nổi góc trái -->
    <FrameLayout
        android:id="@+id/btnHeroBackHome"
        android:layout_width="@dimen/kl3_icon_btn"
        android:layout_height="@dimen/kl3_icon_btn"
        android:layout_gravity="top|start"
        android:layout_marginLeft="@dimen/kl3_sp_xl"
        android:layout_marginTop="@dimen/kl3_sp_lg"
        android:background="@drawable/kl3_btn_icon"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Về trang chủ">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_back"
            android:tint="@color/kl3_text_primary"
            android:contentDescription="Quay lại Trang Chủ" />
    </FrameLayout>

    <!-- 4. Bộ đếm spotlight (góc phải, meta nhỏ) -->
    <TextView
        android:id="@+id/heroSpotlightCounter"
        style="@style/KL3.Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginRight="@dimen/kl3_sp_xl"
        android:layout_marginTop="@dimen/kl3_sp_xl"
        android:text="1/8"
        android:fontFeatureSettings="tnum" />

    <!-- 5. Nội dung neo cạnh dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingBottom="@dimen/kl3_sp_xl">

        <!-- Hàng tag nổi bật -->
        <LinearLayout
            android:id="@+id/heroTrendingTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/kl3_sp_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/KL3.Badge.Hd"
                android:text="NỔI BẬT"
                android:textSize="@dimen/kl3_ts_micro"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/heroTrendingTitle"
                style="@style/KL3.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_md"
                android:text="Tác phẩm điện ảnh được xem nhiều nhất hôm nay"
                android:textColor="@color/kl3_text_secondary" />
        </LinearLayout>

        <!-- Hàng thương hiệu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/kl3_sp_sm">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/kl3m_logo_tile"
                android:gravity="center"
                android:text="K"
                android:textColor="@color/kl3_on_accent"
                android:textSize="@dimen/kl3_ts_meta"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroBrandTag"
                style="@style/KL3.Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="Đ I Ệ N   Ả N H   Đ Ặ C   S Ắ C"
                android:letterSpacing="0.14"
                android:textColor="@color/kl3_text_secondary" />
        </LinearLayout>

        <!-- Tiêu đề lớn -->
        <TextView
            android:id="@+id/heroTitle"
            style="@style/KL3.Text.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="900dp"
            android:textColor="@color/kl3_text_primary" />

        <!-- Hàng thông tin meta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:layout_marginBottom="@dimen/kl3_sp_md">

            <TextView
                android:id="@+id/heroYear"
                style="@style/KL3.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/heroEpisodeCount"
                style="@style/KL3.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:minHeight="@dimen/kl3_badge_h"
                android:gravity="center"
                android:text="Trọn Bộ"
                android:textSize="@dimen/kl3_ts_badge"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/kl3_text_primary" />

            <TextView
                android:id="@+id/heroQuality"
                style="@style/KL3.Badge.Hd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="FHD"
                android:textSize="@dimen/kl3_ts_badge"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/heroGenre"
                style="@style/KL3.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:gravity="center"
                android:text="Hành Động · Viễn Tưởng"
                android:textSize="@dimen/kl3_ts_meta"
                android:textStyle="bold"
                android:textColor="@color/kl3_text_secondary" />
        </LinearLayout>

        <!-- Mô tả -->
        <TextView
            android:id="@+id/heroDesc"
            style="@style/KL3.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="760dp"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            android:ellipsize="end"
            android:textColor="@color/kl3_text_secondary" />

        <!-- Hàng nút hành động: 1 CTA primary + ghost buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_gap_l"
            android:padding="@dimen/kl3_sp_sm"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnHeroPlay"
                style="@style/KL3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶  XEM NGAY"
                android:textAllCaps="true"
                android:textSize="@dimen/kl3_ts_body"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="@font/oswald"
                android:textColor="@color/kl3_on_accent"
                android:nextFocusRight="@id/btnHeroEpisodes"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroEpisodes"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="ℹ  CHỌN TẬP"
                android:nextFocusLeft="@id/btnHeroPlay"
                android:nextFocusRight="@id/btnHeroFavorite"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroFavorite"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="+  LƯU PHIM"
                android:nextFocusLeft="@id/btnHeroEpisodes"
                android:nextFocusRight="@id/btnHeroNext"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroNext"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="PHIM KHÁC  ↻"
                android:nextFocusLeft="@id/btnHeroFavorite"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
