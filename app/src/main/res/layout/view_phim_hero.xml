<?xml version="1.0" encoding="utf-8"?>
<!-- HERO PHIM THIẾT KẾ LẠI (v7.12): full-bleed điện ảnh, KHÔNG còn thanh ngang phía trên.
     Nút Về trang chủ thành nút tròn nổi góc trái; toàn bộ nội dung neo ở cạnh dưới. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/phim_hero_h"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginBottom="4dp"
    android:background="@color/kl_bg_deep">

    <!-- 1. Backdrop full-bleed -->
    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Phim nổi bật" />

    <!-- 2. Scrim chuyển màu (trái + dưới) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- 3. Nút Về trang chủ: nút tròn nổi, không thanh ngang, không badge đi kèm -->
    <FrameLayout
        android:id="@+id/btnHeroBackHome"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_play_pause_circle"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Về trang chủ">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:contentDescription="Quay lại Trang Chủ" />
    </FrameLayout>

    <!-- 4. Số thứ tự spotlight (chữ nhỏ mờ ở góc phải, không phải thanh công cụ) -->
    <TextView
        android:id="@+id/heroSpotlightCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginRight="20dp"
        android:layout_marginTop="22dp"
        android:text="1/8"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- 5. Nội dung neo cạnh dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingBottom="26dp">

        <!-- Hàng nổi bật -->
        <LinearLayout
            android:id="@+id/heroTrendingTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_netflix_top10_badge"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="NỔI BẬT"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroTrendingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Tác phẩm điện ảnh được xem nhiều nhất hôm nay"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hàng thương hiệu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_netflix_top10_badge"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="K"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroBrandTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Đ I Ệ N   Ả N H   Đ Ặ C   S Ắ C"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Tiêu đề lớn -->
        <TextView
            android:id="@+id/heroTitle"
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="900dp"
            android:textSize="34sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDy="3"
            android:shadowRadius="14" />

        <!-- Hàng thông tin -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/heroYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroEpisodeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_netflix_maturity_badge"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Trọn Bộ"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_netflix_maturity_badge"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="FHD"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge_glass"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Hành Động · Viễn Tưởng"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mô tả -->
        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="760dp"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="#CBD5E1"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <!-- Hàng nút hành động -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnHeroPlay"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_netflix_btn_play"
                android:paddingLeft="26dp"
                android:paddingRight="26dp"
                android:text="▶  XEM NGAY"
                android:textColor="#000000"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:nextFocusRight="@id/btnHeroEpisodes"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="ℹ  CHỌN TẬP"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:nextFocusLeft="@id/btnHeroPlay"
                android:nextFocusRight="@id/btnHeroFavorite"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroFavorite"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="+  LƯU PHIM"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:nextFocusLeft="@id/btnHeroEpisodes"
                android:nextFocusRight="@id/btnHeroNext"
                android:focusable="true" />

            <Button
                android:id="@+id/btnHeroNext"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="PHIM KHÁC  ↻"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:nextFocusLeft="@id/btnHeroFavorite"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
