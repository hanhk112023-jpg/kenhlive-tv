<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="340dp"
    android:layout_marginBottom="20dp"
    android:background="@color/kl_bg_deep">

    <!-- 1. Hero Backdrop Image (16:9 Netflix Cinema Spotlight) -->
    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Phim nổi bật" />

    <!-- 2. Multi-directional Netflix Gradient Scrim (Deep Dark Left & Seamless Fade to Bottom) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- 3. Top Navigation & Studio Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingTop="16dp">

        <!-- Quick Back to Home Hub Button -->
        <LinearLayout
            android:id="@+id/btnHeroBackHome"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_hub_pill_btn"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF"
                android:contentDescription="Quay lại Trang Chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="VỀ TRANG CHỦ"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Cinema Studio Quality Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/heroSpotlightCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KENHLIVE CINEMA · 4K VIETSUB"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Content Details (Netflix Billboard Alignment) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingBottom="22dp">

        <!-- Netflix Series / Feature Brand Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_netflix_top10_badge"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="K"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroBrandTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="Đ I Ệ N   Ả N H   Đ Ặ C   S Ắ C"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Movie Title (Large Cinematic Typography) -->
        <TextView
            android:id="@+id/heroTitle"
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="820dp"
            android:textSize="29sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDy="3"
            android:shadowRadius="14" />

        <!-- Film Metadata & Badges Strip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/heroYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Episode / Duration Badge -->
            <TextView
                android:id="@+id/heroEpisodeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_netflix_maturity_badge"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Trọn Bộ"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Quality Badge (4K / FHD) -->
            <TextView
                android:id="@+id/heroQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_netflix_maturity_badge"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="FHD"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Genre Badge -->
            <TextView
                android:id="@+id/heroGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge_glass"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Hành Động · Viễn Tưởng"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spotlight Callout Tag -->
        <LinearLayout
            android:id="@+id/heroTrendingTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_netflix_top10_badge"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="NỔI BẬT"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroTrendingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Tác phẩm điện ảnh được xem nhiều nhất hôm nay"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Short Synopsis (2 Lines Max) -->
        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="740dp"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            android:ellipsize="end"
            android:textSize="12.5sp"
            android:textColor="#CBD5E1"
            android:shadowColor="#E6000000"
            android:shadowDy="2"
            android:shadowRadius="10" />

        <!-- Netflix Action CTAs Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Primary Play Button (Solid White Button, Black Text) -->
            <Button
                android:id="@+id/btnHeroPlay"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_netflix_btn_play"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:text="▶  XEM NGAY"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true" />

            <!-- Secondary Episodes / Details Button (Translucent Dark Gray) -->
            <Button
                android:id="@+id/btnHeroEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="ℹ  CHỌN TẬP"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:focusable="true" />

            <!-- Add to Favorites Button -->
            <Button
                android:id="@+id/btnHeroFavorite"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="+  LƯU PHIM"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:focusable="true" />

            <!-- Next Movie Button -->
            <Button
                android:id="@+id/btnHeroNext"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="↻  PHIM KHÁC"
                android:textColor="#E2E8F0"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
