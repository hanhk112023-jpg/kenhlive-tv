<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:padding="@dimen/kl3_card_h_pad"
    android:layout_marginBottom="@dimen/kl3_sp_sm"
    android:focusable="true"
    android:clickable="true">

    <!-- Icon trong ô kính bo KL3 -->
    <FrameLayout
        android:layout_width="@dimen/kl3_icon_btn_s"
        android:layout_height="@dimen/kl3_icon_btn_s"
        android:background="@drawable/kl3i_icon_box">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="@dimen/kl3_crest_s"
            android:layout_height="@dimen/kl3_crest_s"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/kl3_icon_tint" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="@dimen/kl3_sp_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            style="@style/KL3.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rowDesc"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowValue"
        style="@style/KL3.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/kl3_sp_sm"
        android:textColor="@color/kl3_accent"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="420dp" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="@dimen/kl3_crest_s"
        android:layout_height="@dimen/kl3_crest_s"
        android:layout_marginLeft="@dimen/kl3_sp_sm"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/kl3_text_tertiary"
        android:contentDescription="@null" />
</LinearLayout>
