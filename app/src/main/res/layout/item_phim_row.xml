<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginBottom="22dp">

    <!-- Netflix Row Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:layout_marginBottom="10dp">

        <View
            android:id="@+id/rowAccentDot"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_kl_accent" />

        <TextView
            android:id="@+id/rowTitle"
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rowCount"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Horizontal Carousel List -->
    <!-- Sửa 2026-11-04: thẻ cuối ở mép phải trước đây bị cắt cứng. Thêm fading
         edge ngang để mép phải mờ dần thay vì cắt dọc, và giữ padding phải bằng
         lề màn hình để khi cuộn tới cuối, thẻ cuối vẫn hiện trọn vẹn. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowCarousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="32dp"
        android:scrollbars="none" />

</LinearLayout>
