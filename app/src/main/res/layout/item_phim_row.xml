<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="22dp">

    <!-- Netflix Row Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:layout_marginBottom="10dp">

        <View
            android:id="@+id/rowAccentDot"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_netflix_top10_badge" />

        <TextView
            android:id="@+id/rowTitle"
            style="@style/KL.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rowCount"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Horizontal Carousel List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowCarousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/sp_screen_margin"
        android:paddingRight="@dimen/sp_screen_margin"
        android:scrollbars="none" />

</LinearLayout>
