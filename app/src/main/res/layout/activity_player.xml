<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- BUFFERING SPINNER -->
    <LinearLayout
        android:id="@+id/bufferBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/kl3p_glass_panel"
        android:paddingLeft="@dimen/kl3_sp_xl"
        android:paddingRight="@dimen/kl3_sp_xl"
        android:paddingTop="@dimen/kl3_sp_lg"
        android:paddingBottom="@dimen/kl3_sp_lg"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/kl3_accent" />

        <TextView
            style="@style/KL3.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:text="@string/player_buffering" />
    </LinearLayout>

    <!-- ERROR HUD / RETRY BOX (XỬ LÝ LỖI STREAM / FAILOVER) -->
    <LinearLayout
        android:id="@+id/playerErrorBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/kl3p_glass_panel"
        android:paddingLeft="@dimen/kl3_sp_xxl"
        android:paddingRight="@dimen/kl3_sp_xxl"
        android:paddingTop="@dimen/kl3_sp_xl"
        android:paddingBottom="@dimen/kl3_sp_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_signal_off"
            app:tint="@color/kl3_accent" />

        <TextView
            android:id="@+id/tvPlayerErrorTitle"
            style="@style/KL3.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:text="Lỗi Phát Luồng Video"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayerErrorDetail"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:maxWidth="420dp"
            android:gravity="center"
            android:text="Không thể tải luồng phát này. Vui lòng thử lại hoặc đổi kênh."
            android:textColor="@color/kl3_text_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_lg"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayerRetry"
                style="@style/KL3.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thử Lại"
                android:textColor="@color/kl3_on_accent"
                android:textSize="@dimen/kl3_ts_body"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:maxLines="1"
                android:nextFocusRight="@+id/btnPlayerBack" />

            <Button
                android:id="@+id/btnPlayerBack"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="Quay Lại"
                android:nextFocusLeft="@+id/btnPlayerRetry"
                android:nextFocusRight="@+id/btnPlayerReport" />

            <Button
                android:id="@+id/btnPlayerReport"
                style="@style/KL3.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:text="@string/player_btn_report"
                android:textColor="@color/kl3_info"
                android:nextFocusLeft="@+id/btnPlayerBack" />
        </LinearLayout>

        <TextView
            style="@style/KL3.Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_md"
            android:text="@string/player_report_hint" />
    </LinearLayout>

    <!-- TOP OVERLAY HUD -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/kl3p_scrim_top"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:paddingTop="@dimen/kl3_sp_lg"
            android:paddingBottom="@dimen/kl3_sp_sm">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:text="◀ QUAY LẠI"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/cd_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/kl3_gap"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    style="@style/KL3.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/kl3_ts_body_lg"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_xs"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/playerSub"
                        style="@style/KL3.Text.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sched_live"
                        android:textColor="@color/kl3_live_bright"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_lg">

            <TextView
                android:id="@+id/channelListBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="KÊNH"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/qualityBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="CHẤT LƯỢNG"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/audioBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="ÂM THANH"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/aspectBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="TỈ LỆ"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/sleepBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="HẸN GIỜ"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/audioTrackBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="KÊNH TIẾNG"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/audioBoostBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="TĂNG ÂM"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/statsBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="THÔNG SỐ"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/multiBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="ĐA MÀN HÌNH"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pipBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:layout_marginRight="@dimen/kl3_rail_gap"
                android:text="PIP"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/phoneMenuBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/kl3_btn_h_s"
                android:background="@drawable/kl3_btn_ghost"
                android:foreground="@drawable/kl3_fg_focus_pill"
                android:paddingLeft="@dimen/kl3_chip_pad_x"
                android:paddingRight="@dimen/kl3_chip_pad_x"
                android:text="TÙY CHỌN"
                android:textColor="@color/kl3_text_primary"
                android:textSize="@dimen/kl3_ts_meta"
                android:fontFamily="@font/oswald"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- CENTER PLAY / PAUSE BUTTON (MOBILE TOUCH HUD) -->
    <TextView
        android:id="@+id/centerPlayPauseBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/kl3_btn_ghost"
        android:foreground="@drawable/kl3_fg_focus_pill"
        android:text="❚❚ TẠM DỪNG"
        android:textSize="@dimen/kl3_ts_body"
        android:textColor="@color/kl3_text_primary"
        android:fontFamily="@font/oswald"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:gravity="center"
        android:paddingLeft="@dimen/kl3_sp_xl"
        android:paddingRight="@dimen/kl3_sp_xl"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_md"
        android:minHeight="@dimen/kl3_btn_h"
        android:contentDescription="Phát/Tạm dừng"
        android:focusable="true"
        android:visibility="gone" />

    <!-- BOTTOM MOBILE BAR (PHONE CONTROLS: ROTATE / ASPECT / LIVE BADGE) -->
    <LinearLayout
        android:id="@+id/phoneBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kl3p_scrim_bottom"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPhoneLiveBadge"
            style="@style/KL3.Badge.Live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● TRỰC TIẾP"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.07" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/phoneLockBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/kl3_gap"
            android:minHeight="@dimen/kl3_btn_h"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:paddingLeft="@dimen/kl3_chip_pad_x"
            android:paddingRight="@dimen/kl3_chip_pad_x"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm"
            android:text="KHÓA"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Khóa màn hình" />

        <TextView
            android:id="@+id/phoneAspectBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/kl3_gap"
            android:minHeight="@dimen/kl3_btn_h"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:paddingLeft="@dimen/kl3_chip_pad_x"
            android:paddingRight="@dimen/kl3_chip_pad_x"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm"
            android:text="TỈ LỆ"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Tỉ lệ màn hình" />

        <TextView
            android:id="@+id/phoneRotateBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/kl3_btn_h"
            android:background="@drawable/kl3_btn_ghost"
            android:foreground="@drawable/kl3_fg_focus_pill"
            android:paddingLeft="@dimen/kl3_chip_pad_x"
            android:paddingRight="@dimen/kl3_chip_pad_x"
            android:paddingTop="@dimen/kl3_sp_sm"
            android:paddingBottom="@dimen/kl3_sp_sm"
            android:text="XOAY"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Xoay toàn màn hình" />
    </LinearLayout>

    <!-- VOD SEEK ROW (PHONE ONLY): thanh tua phim + thời gian, hiện cùng overlay trên phoneBottomBar -->
    <LinearLayout
        android:id="@+id/phoneSeekRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kl3p_scrim_bottom"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSeekCurrent"
            style="@style/KL3.Text.Meta"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00:00"
            android:textColor="@color/kl3_text_primary"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekVod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:layout_marginRight="@dimen/kl3_sp_sm"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressTint="@color/kl3_accent"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/tvSeekTotal"
            style="@style/KL3.Text.Meta"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00:00"
            android:textColor="@color/kl3_text_tertiary" />
    </LinearLayout>

    <!-- VOD CONTROL BAR: thanh điều khiển phim gọn, nút kính bo 14dp, focus viền cam -->
    <LinearLayout
        android:id="@+id/vodControlBar"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kl3p_scrim_bottom"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_md"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBarSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_settings"
            android:drawablePadding="4dp"
            android:text="Cài Đặt"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarPrevEp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_skip_prev"
            android:drawablePadding="4dp"
            android:text="Tập trước"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarSeekBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_seek_back"
            android:drawablePadding="4dp"
            android:text="Tua lại"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarPlayPause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_pause"
            android:drawablePadding="4dp"
            android:text="Tạm dừng"
            android:textColor="@color/kl3_accent_bright"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarSeekFwd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_seek_fwd"
            android:drawablePadding="4dp"
            android:text="Tua tới"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarNextEp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_skip_next"
            android:drawablePadding="4dp"
            android:text="Tập tiếp"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBarEpisodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@drawable/kl3p_vod_btn"
            android:foreground="@drawable/kl3p_fg_focus_md"
            android:drawableTop="@drawable/kl_p_episodes"
            android:drawablePadding="4dp"
            android:text="Danh sách tập"
            android:textColor="@color/kl3_text_primary"
            android:textSize="@dimen/kl3_ts_meta"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:focusable="true" />
    </LinearLayout>

    <!-- FLOATING UNLOCK BUTTON (WHEN SCREEN IS LOCKED ON MOBILE) -->
    <LinearLayout
        android:id="@+id/phoneUnlockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|top"
        android:layout_marginLeft="@dimen/kl3_margin_x"
        android:layout_marginTop="@dimen/kl3_margin_x"
        android:background="@drawable/kl3p_glass_panel"
        android:paddingLeft="@dimen/kl3_sp_md"
        android:paddingRight="@dimen/kl3_sp_lg"
        android:paddingTop="@dimen/kl3_sp_sm"
        android:paddingBottom="@dimen/kl3_sp_sm"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_unlock"
            app:tint="@color/kl3_accent"
            android:contentDescription="@null" />

        <TextView
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:text="MỞ KHÓA"
            android:textColor="@color/kl3_text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SIDE PANEL: DANH SÁCH KÊNH PURE BLACK TRƯỢT TỪ BÊN PHẢI -->
    <LinearLayout
        android:id="@+id/channelSidebar"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@color/kl3_bg"
        android:orientation="vertical"
        android:paddingTop="@dimen/kl3_sp_xl"
        android:paddingBottom="@dimen/kl3_sp_xl"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:paddingBottom="@dimen/kl3_sp_md">

            <View
                android:layout_width="@dimen/kl3_section_bar_w"
                android:layout_height="18dp"
                android:background="@color/kl3_accent"
                android:layout_marginRight="@dimen/kl3_sp_sm" />

            <TextView
                style="@style/KL3.Text.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh Sách Kênh" />

            <TextView
                android:id="@+id/sidebarCount"
                style="@style/KL3.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kl3_accent_bright"
                android:textSize="@dimen/kl3_ts_micro"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/kl3_divider_h"
            android:background="@drawable/kl3_divider"
            android:layout_marginBottom="@dimen/kl3_sp_sm" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sidebarChannelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/kl3_sp_sm"
            android:paddingRight="@dimen/kl3_sp_sm"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- BOTTOM CHANNEL CAROUSEL (D-PAD UP/DOWN/OK HIỆN THANH CUỘN NGANG DƯỚI ĐÁY NHƯ TIVIMATE/YOUTUBE) -->
    <LinearLayout
        android:id="@+id/channelCarouselPanel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/kl3p_scrim_bottom"
        android:paddingBottom="@dimen/kl3_sp_lg"
        android:paddingTop="@dimen/kl3_sp_xl"
        android:visibility="gone">

        <!-- Tiêu đề & Thông tin kênh đang focus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:layout_marginBottom="@dimen/kl3_gap">

            <View
                android:layout_width="@dimen/kl3_section_bar_w"
                android:layout_height="18dp"
                android:background="@color/kl3_accent"
                android:layout_marginRight="@dimen/kl3_sp_sm" />

            <TextView
                android:id="@+id/tvCarouselHeader"
                style="@style/KL3.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANH SÁCH TRUYỀN HÌNH" />

            <TextView
                android:id="@+id/tvCarouselCount"
                style="@style/KL3.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:textColor="@color/kl3_accent_bright"
                android:textSize="@dimen/kl3_ts_micro"
                android:textStyle="bold"
                android:text="0 kênh" />

            <TextView
                android:id="@+id/tvCarouselEpgPreview"
                style="@style/KL3.Text.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/kl3_sp_xl"
                android:textColor="@color/kl3_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Bấm ◄/► để chọn kênh, OK để phát ngay" />
        </LinearLayout>

        <!-- Danh sách card cuộn ngang -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannelCarousel"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- QUICK CHANNEL BANNER / OSD (D-PAD UP/DOWN/KEYPAD NHẢY KÊNH PURE BLACK) -->
    <!-- QUICK CHANNEL SWITCHER OSD BANNER (FPT PLAY BOX STYLE) -->
    <LinearLayout
        android:id="@+id/quickChannelOsd"
        android:layout_width="match_parent"
        android:maxWidth="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:orientation="horizontal"
        android:background="@drawable/kl3p_glass_panel"
        android:paddingLeft="@dimen/kl3_sp_xl"
        android:paddingRight="@dimen/kl3_sp_xl"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_md"
        android:gravity="center_vertical"
        android:elevation="@dimen/kl3_elev_3"
        android:visibility="gone">

        <!-- Khung số kênh nổi bật màu cam FPT -->
        <TextView
            android:id="@+id/osdChannelNumber"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/kl3_btn_primary"
            android:gravity="center"
            android:textColor="@color/kl3_on_accent"
            android:textSize="@dimen/kl3_ts_title"
            android:textStyle="bold"
            android:fontFamily="@font/oswald"
            android:text="01" />

        <!-- Logo Kênh nền đen -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:background="@color/kl3_bg_soft"
            android:padding="6dp">

            <ImageView
                android:id="@+id/osdChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/kl_p_channels" />
        </FrameLayout>

        <!-- Thông tin Kênh & EPG -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/kl3_sp_lg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdChannelTitle"
                style="@style/KL3.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/kl3_ts_body_lg"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="VTV1 HD" />

            <TextView
                android:id="@+id/osdEpgNow"
                style="@style/KL3.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:textColor="@color/kl3_accent_bright"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Thời sự 19h" />

            <!-- Progress bar tiến độ chương trình OSD -->
            <ProgressBar
                android:id="@+id/osdEpgProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/kl3_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/osdEpgNext"
                style="@style/KL3.Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kl3_sp_xs"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Tiếp theo: 19:45 Phim truyện" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdTechTag"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:text="FHD 50FPS"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.07" />
    </LinearLayout>

    <!-- GESTURE FEEDBACK BOX (MOBILE SWIPE BRIGHTNESS / VOLUME) -->
    <include layout="@layout/view_gesture_feedback" />

    <!-- STATS FOR NERDS HUD PURE BLACK -->
    <LinearLayout
        android:id="@+id/statsHudBox"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="@dimen/kl3_margin_x"
        android:layout_marginRight="@dimen/kl3_margin_x"
        android:orientation="vertical"
        android:background="@drawable/kl3p_glass_panel"
        android:padding="@dimen/kl3_sp_lg"
        android:elevation="@dimen/kl3_elev_3"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/KL3.Text.Micro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STATS FOR NERDS"
                android:textColor="@color/kl3_accent_bright"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvHudClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/kl3_text_tertiary"
                android:textSize="@dimen/kl3_ts_body"
                android:padding="@dimen/kl3_sp_xs"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/kl3_divider_h"
            android:layout_marginTop="@dimen/kl3_sp_sm"
            android:layout_marginBottom="@dimen/kl3_sp_md"
            android:background="@drawable/kl3_divider" />

        <TextView
            android:id="@+id/tvStatResolution"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kl3_text_secondary"
            android:text="Độ phân giải: Đang đo..." />

        <TextView
            android:id="@+id/tvStatFps"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_secondary"
            android:text="Khung hình: Đang đo..." />

        <TextView
            android:id="@+id/tvStatBitrate"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_secondary"
            android:text="Bitrate: Đang đo..." />

        <TextView
            android:id="@+id/tvStatCodec"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_secondary"
            android:text="Codec: H.264 / AAC" />

        <TextView
            android:id="@+id/tvStatBuffer"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_secondary"
            android:text="Bộ đệm dự trữ: 0.0s" />

        <TextView
            android:id="@+id/tvStatDropped"
            style="@style/KL3.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_secondary"
            android:text="Khung hình rớt: 0" />
    </LinearLayout>

</FrameLayout>
