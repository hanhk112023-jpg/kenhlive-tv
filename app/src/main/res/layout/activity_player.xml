<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- BUFFERING SPINNER -->
    <LinearLayout
        android:id="@+id/bufferBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_badge_glass"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/kl_brand" />

        <TextView
            style="@style/KL.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/kl_text_1"
            android:text="@string/player_buffering" />
    </LinearLayout>

    <!-- TOP OVERLAY HUD -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_top"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/backBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/cd_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerTitle"
                    style="@style/KL.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/playerSub"
                        style="@style/KL.Text.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sched_live"
                        android:textColor="@color/kl_live"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/channelListBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_nav_tv"
                android:contentDescription="Danh sách kênh"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/qualityBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_quality"
                android:contentDescription="@string/settings_video_quality" />

            <ImageButton
                android:id="@+id/audioBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_audio"
                android:contentDescription="@string/settings_audio_mode" />

            <ImageButton
                android:id="@+id/aspectBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_aspect_ratio"
                android:contentDescription="Tỉ lệ khung hình" />

            <ImageButton
                android:id="@+id/sleepBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_sleep_timer"
                android:contentDescription="Hẹn giờ tắt" />

            <ImageButton
                android:id="@+id/audioTrackBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_audio_track"
                android:contentDescription="Kênh âm thanh (Ngôn ngữ)" />

            <ImageButton
                android:id="@+id/audioBoostBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_audio_boost"
                android:contentDescription="Khuếch đại âm lượng" />

            <ImageButton
                android:id="@+id/statsBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_info"
                android:contentDescription="Thông số kỹ thuật" />

            <ImageButton
                android:id="@+id/multiBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_multiview"
                android:contentDescription="@string/nav_multiview" />

            <ImageButton
                android:id="@+id/pipBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_pip"
                android:contentDescription="@string/player_pip_unsupported"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/phoneMenuBtn"
                style="@style/KL.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="Tùy chọn phát"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- CENTER PLAY / PAUSE BUTTON (MOBILE TOUCH HUD) -->
    <ImageButton
        android:id="@+id/centerPlayPauseBtn"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_pause_circle"
        android:src="@drawable/ic_pause"
        android:scaleType="centerInside"
        android:padding="16dp"
        android:contentDescription="Phát/Tạm dừng"
        android:visibility="gone" />

    <!-- BOTTOM MOBILE BAR (PHONE CONTROLS: ROTATE / ASPECT / LIVE BADGE) -->
    <LinearLayout
        android:id="@+id/phoneBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_overlay_bottom"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPhoneLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="● TRỰC TIẾP"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/phoneAspectBtn"
            style="@style/KL.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_aspect_ratio"
            android:contentDescription="Tỉ lệ màn hình" />

        <ImageButton
            android:id="@+id/phoneRotateBtn"
            style="@style/KL.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="Xoay toàn màn hình" />
    </LinearLayout>

    <!-- SIDE PANEL: DANH SÁCH KÊNH PURE BLACK TRƯỢT TỪ BÊN PHẢI -->
    <LinearLayout
        android:id="@+id/channelSidebar"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="#FA000000"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="14dp">

            <View
                android:layout_width="3.5dp"
                android:layout_height="18dp"
                android:background="@drawable/accent_bar"
                android:layout_marginRight="9dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh Sách Kênh"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sidebarCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_glass"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:text="" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#161820"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sidebarChannelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- BOTTOM CHANNEL CAROUSEL (D-PAD UP/DOWN/OK HIỆN THANH CUỘN NGANG DƯỚI ĐÁY NHƯ TIVIMATE/YOUTUBE) -->
    <LinearLayout
        android:id="@+id/channelCarouselPanel"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_carousel_panel"
        android:paddingBottom="16dp"
        android:paddingTop="20dp"
        android:visibility="gone">

        <!-- Tiêu đề & Thông tin kênh đang focus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="3.5dp"
                android:layout_height="18dp"
                android:background="@drawable/accent_bar"
                android:layout_marginRight="10dp" />

            <TextView
                android:id="@+id/tvCarouselHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="DANH SÁCH TRUYỀN HÌNH" />

            <TextView
                android:id="@+id/tvCarouselCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_badge_glass"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:text="0 kênh" />

            <TextView
                android:id="@+id/tvCarouselEpgPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="18dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Bấm ◄/► để chọn kênh, OK để phát ngay" />
        </LinearLayout>

        <!-- Danh sách card cuộn ngang -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannelCarousel"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:clipToPadding="false"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- QUICK CHANNEL BANNER / OSD (D-PAD UP/DOWN/KEYPAD NHẢY KÊNH PURE BLACK) -->
    <LinearLayout
        android:id="@+id/quickChannelOsd"
        android:layout_width="wrap_content"
        android:minWidth="540dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_player_osd_banner"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- Khung số kênh nổi bật -->
        <TextView
            android:id="@+id/osdChannelNumber"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_badge_league_cyan"
            android:gravity="center"
            android:textColor="#00E5FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="01" />

        <!-- Logo Kênh nền đen -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="14dp"
            android:background="#0A0B0E"
            android:padding="6dp">

            <ImageView
                android:id="@+id/osdChannelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_tv" />
        </FrameLayout>

        <!-- Thông tin Kênh & EPG -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdChannelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="VTV1 HD" />

            <TextView
                android:id="@+id/osdEpgNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="▶ Thời sự 19h" />

            <TextView
                android:id="@+id/osdEpgNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="⏭ 19:45: Phim truyện" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdTechTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:background="@drawable/bg_badge_live_red"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="FHD 50FPS" />
    </LinearLayout>

    <!-- STATS FOR NERDS HUD PURE BLACK -->
    <LinearLayout
        android:id="@+id/statsHudBox"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_player_hud_card"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 STATS FOR NERDS"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvHudClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="#1E232E" />

        <TextView
            android:id="@+id/tvStatResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Độ phân giải: Đang đo..." />

        <TextView
            android:id="@+id/tvStatFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Khung hình: Đang đo..." />

        <TextView
            android:id="@+id/tvStatBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Bitrate: Đang đo..." />

        <TextView
            android:id="@+id/tvStatCodec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Codec: H.264 / AAC" />

        <TextView
            android:id="@+id/tvStatBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Bộ đệm dự trữ: 0.0s" />

        <TextView
            android:id="@+id/tvStatDropped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp"
            android:text="Khung hình rớt: 0" />
    </LinearLayout>

    <!-- BOTTOM HINT (TV) -->
    <TextView
        android:id="@+id/playerHint"
        style="@style/KL.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_glass"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="#94A3B8"
        android:textSize="11.5sp"
        android:visibility="gone" />

</FrameLayout>
