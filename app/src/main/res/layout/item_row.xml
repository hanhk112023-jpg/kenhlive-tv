<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@drawable/badge_live"
            android:layout_marginRight="10dp" />

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/oswald"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/rowCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RecyclerView ngang thay vì HorizontalScrollView để recycle view -> tiết kiệm RAM -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:overScrollMode="never" />

    <!-- Legacy container giữ để tương thích nếu code cũ fallback -->
    <HorizontalScrollView
        android:id="@+id/rowScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:visibility="gone"
        android:paddingLeft="10dp"
        android:paddingRight="0dp">

        <LinearLayout
            android:id="@+id/rowContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:id="@+id/rowProgress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
