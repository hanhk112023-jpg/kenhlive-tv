<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="20dp"
    android:maxWidth="640dp">

    <!-- Header: Poster + Movie Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialogFilmPoster"
            android:layout_width="88dp"
            android:layout_height="124dp"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_round_bg"
            android:contentDescription="Poster phim" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogFilmTitle"
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/dialogFilmOrigTitle"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/kl_text_3"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dialogFilmYear"
                    style="@style/KL.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_glass"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/dialogFilmQuality"
                    style="@style/KL.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_badge_hd"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="HD"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/dialogFilmEpisodesCount"
                    style="@style/KL.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:textColor="@color/kl_brand"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialogFilmDesc"
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/kl_text_2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/card_top_divider" />

    <TextView
        style="@style/KL.Text.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH TẬP PHIM"
        android:textSize="13sp"
        android:textColor="@color/kl_text_3"
        android:letterSpacing="0.08" />

    <!-- Loading / Episodes Container -->
    <ProgressBar
        android:id="@+id/dialogLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialogEpisodesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="220dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dialogNoEpisodes"
        style="@style/KL.Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="Chưa có tập phim khả dụng"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="right">

        <Button
            android:id="@+id/dialogBtnFavorite"
            style="@style/KL.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:text="Lưu Phim"
            android:drawableStart="@drawable/ic_bookmark"
            android:drawablePadding="6dp"
            android:drawableTint="#FFD700"
            android:textColor="#FFD700"
            android:focusable="true" />

        <Button
            android:id="@+id/dialogBtnClose"
            style="@style/KL.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Đóng"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
