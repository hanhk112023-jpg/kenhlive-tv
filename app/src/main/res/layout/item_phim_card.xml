<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="134dp"
    android:layout_height="228dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:background="@drawable/sl_apple_card"
    android:focusable="true"
    android:clickable="true"
    android:clipToPadding="false"
    android:padding="4dp">

    <!-- Poster with rounded corners & top badges -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="174dp">

        <ImageView
            android:id="@+id/phimPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_round_bg"
            android:contentDescription="Poster phim" />

        <!-- Top Right Quality Badge (Apple frosted glass) -->
        <TextView
            android:id="@+id/phimQualityBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_hd"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="HD"
            android:textSize="9.5sp"
            android:textColor="#FFFFFF" />

        <!-- Bottom Left Episode Badge -->
        <TextView
            android:id="@+id/phimEpisodeBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Tập 1"
            android:textSize="10sp"
            android:textColor="@color/apple_accent_orange" />

        <!-- Watch Progress Bar at Bottom of Poster (Apple style) -->
        <ProgressBar
            android:id="@+id/phimProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_apple_progress"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Movie Title & Year / Language -->
    <TextView
        android:id="@+id/phimTitle"
        style="@style/KL.Text.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/apple_text_primary" />

    <TextView
        android:id="@+id/phimMeta"
        style="@style/KL.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/apple_text_secondary" />

</LinearLayout>
