<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp"
    android:layout_height="248dp"
    android:layout_marginRight="14dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:background="@drawable/bg_netflix_card"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:clipToPadding="false"
    android:padding="4dp">

    <!-- Poster Container (2:3 Cinema Proportions) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <ImageView
            android:id="@+id/phimPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_round_bg"
            android:contentDescription="Poster phim" />

        <!-- Top Left Rating Badge (Hidden to keep poster clean & authentic) -->
        <TextView
            android:id="@+id/phimRatingBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#FBBF24" />

        <!-- Top Right Quality Badge (Sleek Glass Border) -->
        <TextView
            android:id="@+id/phimQualityBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="6dp"
            android:background="@drawable/bg_quality_glass"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="FHD"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />

        <!-- Bottom Left Episode / Status Badge -->
        <TextView
            android:id="@+id/phimEpisodeBadge"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Tập 1"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Netflix Red Watch Progress Bar at Bottom of Poster -->
        <ProgressBar
            android:id="@+id/phimProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_apple_progress"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Movie Title & Year / Language -->
    <TextView
        android:id="@+id/phimTitle"
        style="@style/KL.Text.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#F8FAFC" />

    <TextView
        android:id="@+id/phimMeta"
        style="@style/KL.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:textSize="10.5sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#94A3B8" />
</LinearLayout>
