<?xml version="1.0" encoding="utf-8"?>
<!-- THẺ PHIM RAIL (dọc 2:3) — KL3.
     Poster @dimen/kl3_poster_w × kl3_poster_h, bo kl3_r_md qua
     kl3_poster_placeholder + clipToOutline. Focus ring = kl3_fg_focus
     foreground; code (PhimCardAdapter) vẫn scale 1.10 + elevation khi focus.
     Giữ nguyên mọi android:id bind trong PhimFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/kl3_poster_w"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/kl3_rail_gap"
    android:layout_marginBottom="@dimen/kl3_sp_sm"
    android:orientation="vertical"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:elevation="@dimen/kl3_elev_1"
    android:focusable="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Poster Container (2:3) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_poster_h">

        <ImageView
            android:id="@+id/phimPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:background="@drawable/kl3_poster_placeholder"
            android:contentDescription="Poster phim" />

        <!-- Top Left Rating Badge (KL3 gold — code đang ẩn, giữ id) -->
        <TextView
            android:id="@+id/phimRatingBadge"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:visibility="gone"
            android:textSize="@dimen/kl3_ts_badge"
            android:letterSpacing="0.04" />

        <!-- Top Right Quality Badge (KL3 HD amber) -->
        <TextView
            android:id="@+id/phimQualityBadge"
            style="@style/KL3.Badge.Hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:text="FHD"
            android:textSize="@dimen/kl3_ts_badge"
            android:letterSpacing="0.06" />

        <!-- Bottom Left Episode / Continue-watching Badge (glass pill) -->
        <TextView
            android:id="@+id/phimEpisodeBadge"
            style="@style/KL3.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="@dimen/kl3_sp_sm"
            android:gravity="center"
            android:text="Tập 1"
            android:textSize="@dimen/kl3_ts_badge"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/kl3_text_primary" />

        <!-- Progress "xem tiếp" — gradient cam KL3M trên track kính -->
        <ProgressBar
            android:id="@+id/phimProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/kl3m_film_progress"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Title & meta dưới poster -->
    <TextView
        android:id="@+id/phimTitle"
        style="@style/KL3.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_xs"
        android:layout_marginLeft="@dimen/kl3_sp_xs"
        android:layout_marginRight="@dimen/kl3_sp_xs"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/phimMeta"
        style="@style/KL3.Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kl3_sp_xs"
        android:layout_marginLeft="@dimen/kl3_sp_xs"
        android:layout_marginRight="@dimen/kl3_sp_xs"
        android:layout_marginBottom="@dimen/kl3_sp_xs"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
