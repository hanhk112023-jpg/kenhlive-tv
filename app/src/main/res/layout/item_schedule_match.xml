<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:foreground="@drawable/fg_focus"
    android:padding="@dimen/sp_item_pad"
    android:layout_marginLeft="@dimen/sp_screen_margin"
    android:layout_marginRight="@dimen/sp_screen_margin"
    android:layout_marginBottom="@dimen/sched_row_gap"
    android:focusable="true"
    android:clickable="true">

    <!-- Cot gio + badge LIVE -->
    <LinearLayout
        android:layout_width="@dimen/sched_time_w"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/matchTime"
            style="@style/KL.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textSize="17sp"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/statusBadge"
            style="@style/KL.Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
<<<<<<< Updated upstream
            android:ellipsize="end"
=======
            android:textSize="10sp"
>>>>>>> Stashed changes
            android:visibility="gone" />
    </LinearLayout>

    <!-- Crest doi nha -->
    <ImageView
        android:id="@+id/hostIcon"
        android:layout_width="@dimen/sched_avatar"
        android:layout_height="@dimen/sched_avatar"
        android:layout_marginLeft="@dimen/sp_item_pad"
        android:contentDescription="@null" />

    <!-- Ten tran -->
    <TextView
        android:id="@+id/matchName"
        style="@style/KL.Text.Title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:maxLines="2"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:ellipsize="end" />

    <!-- Crest doi khach -->
    <ImageView
        android:id="@+id/guestIcon"
        android:layout_width="@dimen/sched_avatar"
        android:layout_height="@dimen/sched_avatar"
        android:contentDescription="@null" />

    <!-- Tag giai -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <ImageView
            android:id="@+id/leagueCrest"
            android:layout_width="@dimen/crest_s"
            android:layout_height="@dimen/crest_s"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/matchLeague"
            style="@style/KL.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- BLV avatars -->
    <LinearLayout
        android:id="@+id/anchorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical" />
</LinearLayout>
