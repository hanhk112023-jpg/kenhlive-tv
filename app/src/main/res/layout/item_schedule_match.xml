<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 schedule row — 1 trận trong tab Lịch (ScheduleAdapter/SportAdapter).
     Timeline: cột giờ + badge → divider dọc → crest → tên → crest → league → BLV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/kl3_card_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:padding="@dimen/kl3_card_h_pad"
    android:elevation="@dimen/kl3_elev_1"
    android:layout_marginLeft="@dimen/kl3_margin_x"
    android:layout_marginRight="@dimen/kl3_margin_x"
    android:layout_marginBottom="@dimen/kl3_gap"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:clickable="true">

    <!-- Cot gio + badge LIVE (code setBackgroundResource badge khi bind) -->
    <LinearLayout
        android:layout_width="@dimen/sched_time_w"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/matchTime"
            style="@style/KL3.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald"
            android:textStyle="bold"
            android:textColor="@color/kl3_text_primary"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/statusBadge"
            style="@style/KL3.Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/kl3_sp_xs"
            android:background="@drawable/kl3_pill_bg"
            android:paddingLeft="@dimen/kl3_badge_pad_x"
            android:paddingRight="@dimen/kl3_badge_pad_x"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_xs"
            android:textColor="@color/kl3_text_tertiary"
            android:textSize="@dimen/kl3_ts_micro"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hairline dọc ngăn cột giờ với nội dung trận -->
    <View
        android:layout_width="@dimen/kl3_divider_h"
        android:layout_height="@dimen/kl3_sp_xxl"
        android:layout_marginLeft="@dimen/kl3_gap"
        android:background="@color/kl3_divider" />

    <!-- Crest doi nha -->
    <ImageView
        android:id="@+id/hostIcon"
        android:layout_width="@dimen/kl3_crest_s"
        android:layout_height="@dimen/kl3_crest_s"
        android:layout_marginLeft="@dimen/kl3_card_h_pad"
        android:background="@drawable/kl3s_avatar_circle"
        android:contentDescription="@null" />

    <!-- Ten tran -->
    <TextView
        android:id="@+id/matchName"
        style="@style/KL3.Text.Title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/kl3_gap"
        android:layout_marginRight="@dimen/kl3_gap"
        android:maxLines="2"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:ellipsize="end" />

    <!-- Crest doi khach -->
    <ImageView
        android:id="@+id/guestIcon"
        android:layout_width="@dimen/kl3_crest_s"
        android:layout_height="@dimen/kl3_crest_s"
        android:background="@drawable/kl3s_avatar_circle"
        android:contentDescription="@null" />

    <!-- Tag giai -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/kl3_gap"
        android:layout_marginRight="@dimen/kl3_gap">

        <ImageView
            android:id="@+id/leagueCrest"
            android:layout_width="@dimen/kl3_crest_s"
            android:layout_height="@dimen/kl3_crest_s"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/matchLeague"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/kl3_sp_sm"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- BLV avatars -->
    <LinearLayout
        android:id="@+id/anchorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical" />
</LinearLayout>
