<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:foreground="@drawable/fg_focus"
    android:padding="@dimen/sp_item_pad"
    android:layout_marginBottom="8dp"
    android:focusable="true"
    android:clickable="true">

    <!-- time / live badge -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/matchTime"
            style="@style/KL.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/statusBadge"
            style="@style/KL.Text.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- crest + teams -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/matchName"
            style="@style/KL.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/leagueCrest"
                android:layout_width="@dimen/crest_s"
                android:layout_height="@dimen/crest_s"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/matchLeague"
                style="@style/KL.Text.Meta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- anchors + team crests -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="right">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/hostIcon"
                android:layout_width="@dimen/sched_avatar"
                android:layout_height="@dimen/sched_avatar"
                android:contentDescription="@null" />

            <TextView
                style="@style/KL.Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="–" />

            <ImageView
                android:id="@+id/guestIcon"
                android:layout_width="@dimen/sched_avatar"
                android:layout_height="@dimen/sched_avatar"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/anchorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>
</LinearLayout>
