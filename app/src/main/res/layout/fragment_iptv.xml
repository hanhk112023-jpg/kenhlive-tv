<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- CỤM TRÊN: HERO PREVIEW KÊNH ĐANG FOCUS (PHONG CÁCH NETFLIX / APPLE TV) -->
    <RelativeLayout
        android:id="@+id/heroPreviewBox"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#08090D"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Bên trái: Chi tiết kênh & EPG lớn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/heroLogoContainer"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingRight="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/heroChannelGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIỆT NAM"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_badge_league_cyan"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="● TRỰC TIẾP HD"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_live_red"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroChannelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="VTV1 HD"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/oswald" />

            <TextView
                android:id="@+id/heroEpgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="▶ Đang phát: Thời sự 19h00"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/heroEpgNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="⏭ Tiếp theo: Phim truyện Việt Nam"
                android:textColor="#94A3B8"
                android:textSize="12.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Bên phải: Khung kính Logo Kênh nổi bật -->
        <FrameLayout
            android:id="@+id/heroLogoContainer"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:background="@drawable/bg_iptv_channel_card"
            android:padding="16dp">

            <ImageView
                android:id="@+id/heroLogoImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_tv" />
        </FrameLayout>

        <!-- Đường kẻ chân Hero mờ dần -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="#1A1F29" />
    </RelativeLayout>

    <!-- THANH DANH MỤC NHÓM KÊNH (VIỆT NAM | THỂ THAO | QUỐC TẾ...) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGroupList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false" />

        <!-- Ô Tìm kiếm nhanh -->
        <EditText
            android:id="@+id/searchChannelInput"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:hint="Tìm kênh TV..."
            android:textColorHint="#475569"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- CỤM DƯỚI: LƯỚI / DẢI KÊNH PURE BLACK BO GÓC MỀM -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/iptvLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iptvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không tìm thấy kênh truyền hình phù hợp"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channelCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
