<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090E">

    <!-- CỤM TRÊN: HERO PREVIEW KÊNH ĐANG FOCUS (PHONG CÁCH APPLE TV CINEMA) -->
    <RelativeLayout
        android:id="@+id/heroPreviewBox"
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:background="@drawable/bg_iptv_hero"
        android:focusable="false"
        android:clickable="true">

        <!-- NỀN TRÌNH PHÁT PREVIEW MỜ MỜ (CINEMATIC AMBIENT VIDEO) -->
        <FrameLayout
            android:id="@+id/heroPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:clickable="false">

            <androidx.media3.ui.PlayerView
                android:id="@+id/heroPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                app:surface_type="texture_view"
                app:use_controller="false"
                app:resize_mode="zoom" />

            <!-- Lớp mờ chuyển tiếp: bên trái tối sâu giữ text nét, bên phải lộ video mềm mại -->
            <View
                android:id="@+id/heroPlayerScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_iptv_hero_scrim" />
        </FrameLayout>

        <!-- NỘI DUNG HERO: THÔNG TIN KÊNH + LOGO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <!-- Bên trái: Chi tiết kênh & Lịch phát sóng EPG lớn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/heroLogoContainer"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingRight="24dp">

            <!-- Dãy huy hiệu trạng thái sang trọng -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/heroChannelGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIỆT NAM"
                    android:textColor="#FFFF6500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:background="@drawable/bg_badge_league_cyan"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="● TRỰC TIẾP"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_live_red"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="FHD"
                    android:textColor="#FFFF6500"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_hd"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <!-- Tên kênh truyền hình -->
            <TextView
                android:id="@+id/heroChannelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="VTV1 HD"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:fontFamily="@font/oswald" />

            <!-- Lịch EPG: Đang phát -->
            <TextView
                android:id="@+id/heroEpgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="▶ Đang phát: Thời sự 19h00"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Progress bar tiến độ EPG FPT Play -->
            <ProgressBar
                android:id="@+id/heroEpgProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="280dp"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="45"
                android:progressDrawable="@drawable/bg_progress_horizontal"
                android:visibility="gone" />

            <!-- Lịch EPG: Tiếp theo -->
            <TextView
                android:id="@+id/heroEpgNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="⏭ Tiếp theo: Phim truyện Việt Nam"
                android:textColor="#94A3B8"
                android:textSize="12.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Gợi ý điều khiển TV -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bấm [OK] để xem toàn màn hình • Bấm [Lên/Xuống] để duyệt kênh"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bên phải: Khung kính Logo Kênh 3D nổi bật -->
        <FrameLayout
            android:id="@+id/heroLogoContainer"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_iptv_logo_frame"
            android:padding="12dp">

            <ImageView
                android:id="@+id/heroLogoImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_tv" />
        </FrameLayout>
        </RelativeLayout>

        <!-- Đường kẻ viền chân Hero mờ dần -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="#1B2232" />
    </RelativeLayout>

    <!-- THANH DANH MỤC NHÓM KÊNH & Ô TÌM KIẾM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGroupList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false" />

        <!-- Ô Tìm kiếm nhanh phong cách bo tròn -->
        <EditText
            android:id="@+id/searchChannelInput"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_marginLeft="14dp"
            android:hint="Tìm kênh TV..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_iptv_chip"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- CỤM DƯỚI: LƯỚI THẺ KÊNH TV (5 CỘT) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/iptvLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/kl_brand"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iptvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không tìm thấy kênh truyền hình phù hợp"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channelCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="28dp"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFF6500"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>