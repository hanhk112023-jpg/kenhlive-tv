<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl3_bg">

    <!-- ============ HERO PREVIEW: kênh đang focus ============ -->
    <RelativeLayout
        android:id="@+id/heroPreviewBox"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kl3_hero_h"
        android:background="@color/kl3_bg_soft"
        android:focusable="false"
        android:clickable="true">

        <!-- Lớp video preview mờ phía sau -->
        <FrameLayout
            android:id="@+id/heroPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:clickable="false">

            <androidx.media3.ui.PlayerView
                android:id="@+id/heroPlayerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                app:surface_type="texture_view"
                app:use_controller="false"
                app:resize_mode="zoom" />

            <!-- Scrim KL3: fade trái + đáy giữ chữ nét trên mọi nền -->
            <View
                android:id="@+id/heroPlayerScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kl3_hero_scrim" />
        </FrameLayout>

        <!-- Nội dung hero: thông tin kênh + EPG + logo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:paddingTop="@dimen/kl3_sp_lg"
            android:paddingBottom="@dimen/kl3_sp_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/heroLogoContainer"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/kl3_margin_x">

                <!-- Hàng badge trạng thái -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/heroChannelGroup"
                        style="@style/KL3.Badge.Provider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIỆT NAM"
                        android:textSize="@dimen/kl3_ts_badge"
                        android:letterSpacing="0.06" />

                    <TextView
                        style="@style/KL3.Badge.Live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_sm"
                        android:text="● TRỰC TIẾP"
                        android:textSize="@dimen/kl3_ts_badge" />

                    <TextView
                        style="@style/KL3.Badge.Hd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/kl3_sp_xs"
                        android:text="FHD"
                        android:textSize="@dimen/kl3_ts_badge" />
                </LinearLayout>

                <!-- Tên kênh -->
                <TextView
                    android:id="@+id/heroChannelTitle"
                    style="@style/KL3.Text.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_sm"
                    android:text="VTV1 HD"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- EPG: đang phát -->
                <TextView
                    android:id="@+id/heroEpgNow"
                    style="@style/KL3.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_xs"
                    android:text="Đang phát: Thời sự 19h00"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Progress EPG (Kotlin tự chỉnh width theo thiết bị) -->
                <ProgressBar
                    android:id="@+id/heroEpgProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="280dp"
                    android:layout_height="@dimen/kl3_sp_xs"
                    android:layout_marginTop="@dimen/kl3_sp_xs"
                    android:max="100"
                    android:progress="45"
                    android:progressDrawable="@drawable/kl3i_progress_horizontal"
                    android:visibility="gone" />

                <!-- EPG: tiếp theo -->
                <TextView
                    android:id="@+id/heroEpgNext"
                    style="@style/KL3.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_xs"
                    android:text="Tiếp theo: Phim truyện Việt Nam"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Gợi ý điều khiển (code đổi theo phone/TV) -->
                <TextView
                    android:id="@+id/heroHintText"
                    style="@style/KL3.Text.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/kl3_sp_sm"
                    android:text="Bấm [OK] để xem toàn màn hình • Bấm [Lên/Xuống] để duyệt kênh" />
            </LinearLayout>

            <!-- Khung logo kênh — glass panel, code ẩn khi phone dọc -->
            <FrameLayout
                android:id="@+id/heroLogoContainer"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/kl3i_logo_frame"
                android:padding="@dimen/kl3_sp_md">

                <ImageView
                    android:id="@+id/heroLogoImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_tv" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Hairline chân hero -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/kl3_divider_h"
            android:layout_alignParentBottom="true"
            android:background="@drawable/kl3_divider" />
    </RelativeLayout>

    <!-- ============ THANH NHÓM KÊNH + TÌM KIẾM + M3U ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/kl3_sp_md"
        android:paddingBottom="@dimen/kl3_sp_sm"
        android:paddingLeft="@dimen/kl3_margin_x"
        android:paddingRight="@dimen/kl3_margin_x">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGroupList"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false" />

        <EditText
            android:id="@+id/searchChannelInput"
            style="@style/KL3.Input"
            android:layout_width="@dimen/iptv_search_w"
            android:layout_height="@dimen/kl3_input_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:hint="Tìm kênh TV..." />

        <LinearLayout
            android:id="@+id/btnIptvAddM3u"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kl3_btn_h"
            android:layout_marginLeft="@dimen/kl3_gap"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/kl3_btn_ghost"
            android:paddingLeft="@dimen/kl3_sp_lg"
            android:paddingRight="@dimen/kl3_sp_lg"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:layout_width="@dimen/kl3_crest_s"
                android:layout_height="@dimen/kl3_crest_s"
                android:src="@drawable/ic_nav_tv"
                android:tint="@color/kl3_accent"
                android:contentDescription="@null" />

            <TextView
                style="@style/KL3.Text.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/kl3_sp_sm"
                android:text="THÊM M3U" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ LƯỚI KÊNH TV ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:paddingTop="@dimen/kl3_sp_xs"
            android:paddingBottom="@dimen/kl3_sp_xl"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/iptvLoading"
            android:layout_width="@dimen/kl3_icon_btn"
            android:layout_height="@dimen/kl3_icon_btn"
            android:layout_gravity="center"
            android:indeterminateTint="@color/kl3_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iptvEmptyText"
            style="@style/KL3.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingLeft="@dimen/kl3_margin_x"
            android:paddingRight="@dimen/kl3_margin_x"
            android:gravity="center"
            android:text="Không tìm thấy kênh truyền hình phù hợp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channelCountText"
            style="@style/KL3.Text.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_marginRight="@dimen/kl3_sp_xl"
            android:layout_marginBottom="@dimen/kl3_sp_lg"
            android:textColor="@color/kl3_gold"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
