<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Header Section: Tiêu đề phẳng + Bộ đếm kênh + Thanh tìm kiếm -->
    <LinearLayout
        android:id="@+id/iptvTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="@drawable/accent_bar"
                android:layout_marginRight="10dp" />

            <TextView
                android:id="@+id/iptvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Truyền Hình OTT"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/channelCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:background="@drawable/bg_badge_glass"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#00E5FF"
                android:textSize="11.5sp"
                android:text="Đang kết nối..." />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Ô Tìm kiếm nhanh kênh OTT -->
        <EditText
            android:id="@+id/searchChannelInput"
            android:layout_width="260dp"
            android:layout_height="38dp"
            android:hint="Tìm kênh (VTV, K+, Thể thao...)"
            android:textColorHint="#475569"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- Phân loại danh mục: Việt Nam | Thể thao | DAZN | Sky Sports... -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iptvGroupList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="12dp" />

    <!-- Lưới danh sách kênh OTT chuẩn 10-foot TV -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/iptvLoading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iptvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không tìm thấy kênh phù hợp."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
