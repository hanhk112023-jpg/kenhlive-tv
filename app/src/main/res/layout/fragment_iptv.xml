<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kl_bg_deep">

    <!-- Top Bar: Tiêu đề + Thống kê + Tìm kiếm nhanh + Thêm M3U -->
    <LinearLayout
        android:id="@+id/iptvTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/iptvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Truyền hình OTT &amp; Thể thao"
                android:textColor="@color/kl_text_1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channelCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/kl_cyan"
                android:textSize="12sp"
                android:text="Đang cập nhật danh mục..." />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Ô Tìm kiếm nhanh kênh -->
        <EditText
            android:id="@+id/searchChannelInput"
            android:layout_width="220dp"
            android:layout_height="38dp"
            android:hint="Tìm kênh (VTV, ESPN...)"
            android:textColorHint="@color/kl_text_3"
            android:textColor="@color/kl_text_1"
            android:textSize="13sp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <!-- Nút Làm mới danh sách -->
        <Button
            android:id="@+id/btnRefreshIptv"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Làm mới"
            android:textColor="@color/kl_text_1"
            android:textSize="12sp"
            android:background="@drawable/bg_button_ghost"
            android:focusable="true"
            android:clickable="true"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_marginRight="8dp" />

        <!-- Nút Thêm M3U tùy chỉnh -->
        <Button
            android:id="@+id/btnManageM3u"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Thêm M3U"
            android:textColor="@color/kl_on_brand"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:focusable="true"
            android:clickable="true"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />
    </LinearLayout>

    <!-- Thanh phân loại danh mục (Việt Nam, Thể thao, Kênh riêng...) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iptvGroupList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="10dp" />

    <!-- Lưới danh sách thẻ kênh -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iptvGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/iptvLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/iptvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Không tìm thấy kênh phù hợp."
            android:textColor="@color/kl_text_3"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
