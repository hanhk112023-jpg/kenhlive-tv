<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 primary button — warm orange→amber gradient pill.
     focused: white ring (reads at TV distance); pressed: dimmed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:startColor="@color/kl3_accent_bright"
                        android:endColor="@color/kl3_accent_deep" />
                    <corners android:radius="@dimen/kl3_r_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="3dp" android:color="#FFFFFFFF" />
                    <corners android:radius="@dimen/kl3_r_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_accent_deep" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/kl3_accent_bright"
                android:endColor="@color/kl3_accent_deep" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
</selector>
