<?xml version="1.0" encoding="utf-8"?>
<!-- KL2: ô nhập dạng pill (tìm kênh IPTV) — kính tối, focus viền cam kl_brand. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF16181D" />
            <stroke
                android:width="2dp"
                android:color="@color/kl_focus_ring" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF101216" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
</selector>
