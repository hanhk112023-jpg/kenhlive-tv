<?xml version="1.0" encoding="utf-8"?>
<!-- KL2: pill tiện ích ở HomeHub — kính mờ mặc định; focus chuyển cam kl_brand (chữ trắng vẫn đọc rõ). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand_pressed" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
</selector>
