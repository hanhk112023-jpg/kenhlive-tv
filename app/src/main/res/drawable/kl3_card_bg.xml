<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 standard card background: deep surface + hairline border.
     focused/selected → brighter surface + accent border (glow ring is
     provided separately by kl3_fg_focus foreground). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/kl3_surface_high"
                android:endColor="@color/kl3_surface" />
            <stroke android:width="1.5dp" android:color="@color/kl3_accent_dim" />
            <corners android:radius="@dimen/kl3_r_lg" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/kl3_surface_high"
                android:endColor="@color/kl3_surface" />
            <stroke android:width="1.5dp" android:color="@color/kl3_accent_dim" />
            <corners android:radius="@dimen/kl3_r_lg" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_pressed" />
            <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
            <corners android:radius="@dimen/kl3_r_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/kl3_surface"
                android:endColor="@color/kl3_bg_soft" />
            <stroke android:width="1dp" android:color="@color/kl3_divider" />
            <corners android:radius="@dimen/kl3_r_lg" />
        </shape>
    </item>
</selector>
