<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke android:width="6dp" android:color="@color/kl_focus_glow" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/kl_brand_soft" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="@color/kl_focus_ring" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_pressed_overlay" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand_soft" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/kl_brand_dim" />
        </shape>
    </item>
    <item><color android:color="#00000000" /></item>
</selector>
