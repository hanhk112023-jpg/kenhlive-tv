<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#30113B"
                android:centerColor="#1E0B29"
                android:endColor="#0E121B"
                android:angle="315" />
            <stroke
                android:width="2.5dp"
                android:color="@color/kl_amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#17091D"
                android:centerColor="#100816"
                android:endColor="#0A0C11"
                android:angle="315" />
            <stroke
                android:width="1dp"
                android:color="#33FFB300" />
        </shape>
    </item>
</selector>
