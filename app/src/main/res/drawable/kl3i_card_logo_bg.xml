<?xml version="1.0" encoding="utf-8"?>
<!-- KL3I channel-card logo box — deep poster gradient (kl3_poster_a→b)
     with hairline border, r_md corners. Sits behind channelLogo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/kl3_poster_a"
        android:endColor="@color/kl3_poster_b" />
    <stroke android:width="1dp" android:color="@color/kl3_divider" />
    <corners android:radius="@dimen/kl3_r_md" />
</shape>
