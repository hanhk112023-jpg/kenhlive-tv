<?xml version="1.0" encoding="utf-8"?>
<!-- KL3S section accent bar — 4dp-wide warm orange gradient strip used
     next to section headers ("TRỰC TIẾP", day labels...). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/kl3_accent_bright"
        android:endColor="@color/kl3_accent_deep" />
    <corners android:radius="2dp" />
</shape>
