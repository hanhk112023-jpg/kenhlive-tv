<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2000E5FF" />
            <stroke android:width="2dp" android:color="#00E5FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00E5FF" />
            <stroke android:width="1.5dp" android:color="#00E5FF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1017" />
            <stroke android:width="1dp" android:color="#1E2433" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
