<?xml version="1.0" encoding="utf-8"?>
<!-- KL3P player scrim — top fade for OSD/top bars over video.
     Heavier than kl3_scrim_bottom: near-opaque at top edge, transparent below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/kl3_scrim_85"
                android:centerColor="@color/kl3_scrim_40"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
