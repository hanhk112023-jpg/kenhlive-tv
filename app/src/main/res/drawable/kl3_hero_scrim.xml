<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 hero scrim — combined bottom + left fade so hero copy stays
     legible over any backdrop image. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="@color/kl3_scrim_85"
                android:centerColor="@color/kl3_scrim_40"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="@color/kl3_scrim_60"
                android:centerColor="@color/kl3_scrim_20"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
