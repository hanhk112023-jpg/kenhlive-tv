<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/kl_surface_3" />
            <stroke android:width="@dimen/focus_ring_w" android:color="@color/kl_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/kl_pressed_overlay" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/kl_surface_translucent" /></shape>
    </item>
</selector>
