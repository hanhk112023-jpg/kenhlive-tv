<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/kl_brand" />
                    <corners android:radius="@dimen/rd_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/focus_ring_w" android:color="@color/kl_focus_ring" />
                    <corners android:radius="@dimen/rd_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand_pressed" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
</selector>
