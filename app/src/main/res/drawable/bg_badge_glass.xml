<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="0"
    android:exitFadeDuration="0">
    <!-- Focused + Selected: vòng focus cam 2.5dp @color/kl_focus_ring, giống chip chất lượng/âm thanh -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="2.5dp" android:color="@color/kl_focus_ring" />
        </shape>
    </item>
    <!-- Focused: vòng focus cam 2.5dp + nền sáng nhẹ -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="2.5dp" android:color="@color/kl_focus_ring" />
        </shape>
    </item>
    <!-- Bình thường: giữ nguyên diện mạo cũ (badge không focusable dùng trạng thái này) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B312131A" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="1dp" android:color="@color/kl_border_soft" />
        </shape>
    </item>
</selector>
