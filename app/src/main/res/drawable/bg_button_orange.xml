<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF5722"
                android:endColor="#FFF4511E" />
            <stroke android:width="2.5dp" android:color="#FF00E5FF" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE64A19" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF6E40"
                android:endColor="#FFFF3D00" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
</selector>
