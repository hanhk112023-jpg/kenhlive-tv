<?xml version="1.0" encoding="utf-8"?>
<!-- KL2: bảng tỉ số / giờ đấu — slate sâu, viền sáng nhẹ, bo 12dp (đồng bộ thẻ kính kl2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF252C3A"
        android:endColor="#FF12161F" />
    <stroke
        android:width="1dp"
        android:color="#3D475C" />
    <corners android:radius="12dp" />
</shape>
