<?xml version="1.0" encoding="utf-8"?>
<!-- KL3P glass panel — rounded glass card for player HUDs
     (buffer box, error card, stats HUD, gesture feedback, channel OSD).
     radius = kl3_r_xl so it reads as an overlay surface, not a pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kl3_glass_strong" />
    <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
    <corners android:radius="@dimen/kl3_r_xl" />
</shape>
