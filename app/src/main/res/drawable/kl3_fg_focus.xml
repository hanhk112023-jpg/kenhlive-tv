<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 focus ring — FOREGROUND drawable for cards/containers.
     Two-layer stroke: wide soft accent glow + crisp accent line.
     Transparent when unfocused so it can sit on any background. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/kl3_focus_glow_w" android:color="@color/kl3_accent_glow" />
                    <corners android:radius="@dimen/kl3_r_lg" />
                </shape>
            </item>
            <item android:left="@dimen/kl3_focus_ring_w_s" android:top="@dimen/kl3_focus_ring_w_s"
                android:right="@dimen/kl3_focus_ring_w_s" android:bottom="@dimen/kl3_focus_ring_w_s">
                <shape android:shape="rectangle">
                    <stroke android:width="@dimen/kl3_focus_ring_w" android:color="@color/kl3_accent" />
                    <corners android:radius="@dimen/kl3_r_lg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/kl3_focus_ring_w" android:color="@color/kl3_accent" />
            <corners android:radius="@dimen/kl3_r_lg" />
        </shape>
    </item>
    <item><color android:color="#00000000" /></item>
</selector>
