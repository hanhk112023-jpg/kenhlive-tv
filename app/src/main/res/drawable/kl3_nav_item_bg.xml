<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 nav item background (TV side rail / phone bottom nav).
     focused = glass fill + accent border; selected = soft accent fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_glass_strong" />
            <stroke android:width="2dp" android:color="@color/kl3_accent" />
            <corners android:radius="@dimen/kl3_r_md" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_accent_soft" />
            <stroke android:width="1dp" android:color="@color/kl3_accent_dim" />
            <corners android:radius="@dimen/kl3_r_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_pressed" />
            <corners android:radius="@dimen/kl3_r_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/kl3_r_md" />
        </shape>
    </item>
</selector>
