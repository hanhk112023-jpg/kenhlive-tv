<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_brand_soft" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="@dimen/focus_ring_w" android:color="@color/kl_brand" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#3300E676"
                android:endColor="#1A00E676" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="1.5dp" android:color="@color/kl_brand" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_pressed_overlay" />
            <corners android:radius="@dimen/rd_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_surface_2" />
            <corners android:radius="@dimen/rd_pill" />
            <stroke android:width="1dp" android:color="@color/kl_border_soft" />
        </shape>
    </item>
</selector>
