<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 round icon button — dark glass circle, accent ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/kl3_surface_high" />
                    <stroke android:width="@dimen/kl3_focus_ring_w" android:color="@color/kl3_accent" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <stroke android:width="@dimen/kl3_focus_glow_w" android:color="@color/kl3_accent_glow" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/kl3_pressed" />
            <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/kl3_glass_strong" />
            <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
        </shape>
    </item>
</selector>
