<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 ghost button — frosted glass pill, accent border on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_glass_strong" />
            <stroke android:width="@dimen/kl3_focus_ring_w" android:color="@color/kl3_accent" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_pressed" />
            <stroke android:width="1.5dp" android:color="@color/kl3_glass_border" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_accent_soft" />
            <stroke android:width="1.5dp" android:color="@color/kl3_accent_dim" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_glass" />
            <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
            <corners android:radius="@dimen/kl3_r_pill" />
        </shape>
    </item>
</selector>
