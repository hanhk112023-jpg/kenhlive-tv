<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/btn_cta_tex" android:gravity="center" />
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke android:width="2dp" android:color="#00F0FF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="#33FFB800" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>