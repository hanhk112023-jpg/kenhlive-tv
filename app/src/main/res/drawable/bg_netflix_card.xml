<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ phim: thường = viền mờ rất nhẹ (poster tự nổi, không đóng khung xám);
     focus = viền cam thương hiệu 2.5dp + nền nâng nhẹ. Bo góc 12dp đồng bộ poster. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF161922" />
            <stroke
                android:width="2.5dp"
                android:color="#FF9F0A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FF0E1015" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
