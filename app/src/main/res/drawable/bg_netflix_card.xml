<?xml version="1.0" encoding="utf-8"?>
<!-- Sửa 2026-11-04: thẻ phim GÓC VUÔNG, KHÔNG dùng khung/viền nữa.
     Focus nhận biết bằng hiệu ứng nổi trong code (scale + elevation),
     không phải bằng stroke. Vì vậy cả 2 trạng thái đều không có stroke,
     chỉ khác nền một chút để thẻ focus sáng hơn khi nổi lên.
     Góc vuông 0dp đồng bộ poster (thumb_round_bg). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="#FF1E222E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="#FF0E1015" />
        </shape>
    </item>
</selector>
