<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:startColor="#171B26" android:endColor="#121316" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFB800" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#171B26" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFB800" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#121316" android:endColor="#0B0F19" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#222222" />
        </shape>
    </item>
</selector>