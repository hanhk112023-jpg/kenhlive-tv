<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:startColor="#1E1E1E" android:endColor="#151515" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFD166" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1E1E1E" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FF9F1C" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#151515" android:endColor="#0A0A0A" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#222222" />
        </shape>
    </item>
</selector>