<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="270" android:startColor="#2E3A5C" android:endColor="#1A2238" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFD166" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2E3A5C" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FF9F1C" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#1B2438" android:endColor="#121826" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#252E4A" />
        </shape>
    </item>
</selector>