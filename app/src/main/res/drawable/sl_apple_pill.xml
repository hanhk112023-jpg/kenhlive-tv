<?xml version="1.0" encoding="utf-8"?>
<!-- Pill danh mục CHƯA chọn: focus = kính sáng viền trắng (bg_apple_pill_focus),
     thường = kính mờ. Trạng thái ĐÃ CHỌN do adapter gán sl_apple_pill_selected riêng. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_apple_pill_focus" />
    <item android:state_pressed="true" android:drawable="@drawable/bg_apple_pill_focus" />
    <item android:drawable="@drawable/bg_apple_pill" />
</selector>
