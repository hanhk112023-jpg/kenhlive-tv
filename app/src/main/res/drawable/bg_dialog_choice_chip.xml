<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="0"
    android:exitFadeDuration="0">
    <!-- Focused & Selected: Viền Cyan sáng rực 2.5dp, nền xanh ngọc đằm -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300E5FF" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="#FF00E5FF" />
        </shape>
    </item>
    <!-- Focused (chưa chọn): Viền trắng sáng 2.5dp, nền xám than -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Selected (không focus): Nền xám xanh cyan dịu, KHÔNG VIỀN SÁNG để không lẫn với Focus! -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600E5FF" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#3300E5FF" />
        </shape>
    </item>
    <!-- Bình thường (chưa chọn, không focus) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141822" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#263042" />
        </shape>
    </item>
</selector>
