<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected: Viền Cyan sáng rực, nền xanh ngọc đằm -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600E5FF" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <!-- Focused (chưa chọn): Viền trắng rõ, nền xám than -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Selected (không focus): Viền Cyan mảnh, nền xám tối -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1400E5FF" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#00E5FF" />
        </shape>
    </item>
    <!-- Bình thường (mặc định) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141822" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#263042" />
        </shape>
    </item>
</selector>
