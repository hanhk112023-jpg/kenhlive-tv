<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFFF6500" android:endColor="#FFFF8C00" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FF6500" />
            <stroke android:width="2dp" android:color="#FFFF6500" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FF6500" />
            <stroke android:width="1.2dp" android:color="#80FF6500" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
