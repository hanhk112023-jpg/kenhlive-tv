<?xml version="1.0" encoding="utf-8"?>
<!-- KL3I icon chip box — rounded-square glass container (r_sm) used for
     settings row icons and small decorative badges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kl3_glass_strong" />
    <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
    <corners android:radius="@dimen/kl3_r_sm" />
</shape>
