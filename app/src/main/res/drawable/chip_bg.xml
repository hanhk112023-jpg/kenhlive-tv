<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1E3A5C" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#4CC9F0" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#1A2C4E" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#4CC9F0" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141927" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#232B42" />
        </shape>
    </item>
</selector>
