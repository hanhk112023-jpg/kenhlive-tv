<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#202124" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#4CC9F0" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#121316" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#4CC9F0" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#121316" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#121316" />
        </shape>
    </item>
</selector>
