<?xml version="1.0" encoding="utf-8"?>
<!-- KL2: thẻ kênh IPTV — kính sâu bo 16dp; focus viền cam kl_brand 2.5dp + mặt sáng hơn. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF1E222C"
                android:centerColor="#FF14171F"
                android:endColor="#FF0D0F14" />
            <stroke
                android:width="2.5dp"
                android:color="@color/kl_brand" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF1E222C"
                android:centerColor="#FF14171F"
                android:endColor="#FF0D0F14" />
            <stroke
                android:width="2.5dp"
                android:color="@color/kl_brand" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#FF161922"
                android:centerColor="#FF10131A"
                android:endColor="#FF0B0D12" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
