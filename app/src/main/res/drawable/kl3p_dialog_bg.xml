<?xml version="1.0" encoding="utf-8"?>
<!-- KL3P dialog surface — kl3_surface_top with kl3_r_xl corners
     and a hairline glass border. Used by player settings / room picker. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kl3_surface_top" />
    <stroke android:width="1dp" android:color="@color/kl3_glass_border" />
    <corners android:radius="@dimen/kl3_r_xl" />
</shape>
