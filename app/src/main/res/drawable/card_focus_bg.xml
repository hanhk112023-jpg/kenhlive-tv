<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Glow shadow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33FF3B30" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- Main card focused -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1E1E26" />
                    <corners android:radius="16dp" />
                    <stroke android:width="2.5dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A22" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2A2A32" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
