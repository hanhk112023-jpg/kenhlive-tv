<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#141720" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1.5dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#161A24" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1dp" android:color="#1E2430" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0E12" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1dp" android:color="#1A1F29" />
        </shape>
    </item>
</selector>
