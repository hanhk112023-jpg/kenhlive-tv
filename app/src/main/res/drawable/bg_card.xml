<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_surface_2" />
            <corners android:radius="@dimen/rd_card" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_surface_3" />
            <corners android:radius="@dimen/rd_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kl_surface_1" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1dp" android:color="@color/kl_border_soft" />
        </shape>
    </item>
</selector>
