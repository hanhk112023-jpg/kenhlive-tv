<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#161922" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="2dp" android:color="@color/kl_focus_ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1E29" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1dp" android:color="#33FF6500" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0E14" />
            <corners android:radius="@dimen/rd_card" />
            <stroke android:width="1dp" android:color="#1A202C" />
        </shape>
    </item>
</selector>
