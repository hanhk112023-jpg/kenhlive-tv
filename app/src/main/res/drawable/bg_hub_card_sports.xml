<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#3D1704"
                android:centerColor="#210E09"
                android:endColor="#0E121B"
                android:angle="315" />
            <stroke
                android:width="2.5dp"
                android:color="@color/kl_brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#1A0C04"
                android:centerColor="#120A07"
                android:endColor="#0A0C11"
                android:angle="315" />
            <stroke
                android:width="1dp"
                android:color="#33FF6500" />
        </shape>
    </item>
</selector>
