<?xml version="1.0" encoding="utf-8"?>
<!-- Sửa 2026-11-04: focus thống nhất viền cam kl_brand cho mọi thẻ hub; khi chưa focus chỉ còn viền trắng mờ trung tính, không còn viền cam/cyan/amber nhạt gây cảm giác "thẻ vẫn đang được chọn" khi focus đã sang nút khác. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#3D1704"
                android:centerColor="#210E09"
                android:endColor="#0E121B"
                android:angle="315" />
            <stroke
                android:width="2.5dp"
                android:color="@color/kl_brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#1A0C04"
                android:centerColor="#120A07"
                android:endColor="#0A0C11"
                android:angle="315" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
