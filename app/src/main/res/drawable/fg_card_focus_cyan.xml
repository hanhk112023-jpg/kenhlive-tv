<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Glow cyan bên ngoài -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1A00E5FF" />
                    <stroke android:width="6dp" android:color="#3300E5FF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- Viền chính cyan neon nổi khối -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0D00E5FF" />
                    <stroke android:width="3dp" android:color="#FF00E5FF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
