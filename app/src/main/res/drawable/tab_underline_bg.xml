<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#1AFF3B30" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="3dp" android:left="8dp" android:right="8dp">
                <shape><solid android:color="#FF3B30" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1E1E26" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1.5dp" android:color="#3A3A44" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape><solid android:color="#00000000" /></shape>
    </item>
</selector>
