<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="3dp">
                <shape><solid android:color="#FF3B30" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#FF3B30" />
                    <corners android:radius="8dp" />
                    <solid android:color="#14FF3B30" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape><solid android:color="#00000000" /></shape>
    </item>
</selector>