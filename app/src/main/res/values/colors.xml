    <color name="kl_live">#FFFF334B</color>
    <color name="kl_live_glow">#55FF334B</color>
    <color name="kl_live_dim">#26FF334B</color>
    <color name="kl_error">#FFFF4D4D</color>
    <color name="kl_focus_ring">#FFFF6500</color>
    <color name="kl_focus_glow">#66FF6500</color>
