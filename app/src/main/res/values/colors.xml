<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     KÊNH LIVE — DESIGN TOKENS (single source of truth)
     Phone + TV share the same palette; only sizes/spacing change
     via values/dimens.xml vs values-television/dimens.xml.
     ============================================================ -->
<resources>
    <!-- brand (FPT TV Signature Orange) -->
    <color name="kl_brand">#FFFF6500</color>
    <color name="kl_brand_pressed">#FFFA5200</color>
    <color name="kl_brand_glow">#55FF6500</color>
    <color name="kl_brand_dim">#26FF6500</color>
    <color name="kl_brand_soft">#14FF6500</color>
    <color name="kl_on_brand">#FFFFFFFF</color>
    <color name="kl_cyan">#FF00E5FF</color>
    <color name="kl_amber">#FFFFB300</color>
    <color name="fpt_orange">#FFFF6500</color>
    <color name="fpt_orange_gradient_end">#FFFF8C00</color>
    <color name="fpt_dark_card">#FF101217</color>
    <color name="fpt_dark_surface">#FF090A0D</color>

    <!-- surfaces (pure black, obsidian & sleek glass - no navy) -->
    <color name="kl_bg">#FF000000</color>
    <color name="kl_bg_deep">#FF000000</color>
    <color name="kl_surface_1">#FF0D0E12</color>
    <color name="kl_surface_2">#FF13151B</color>
