<?xml version="1.0" encoding="utf-8"?>
<!-- KL3 nav rail item (Android TV). Focus ring = kl3_fg_focus foreground;
     selected = accent tint qua kl3_nav_item_bg / kl3_nav_text / kl3_icon_tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="@dimen/kl3_sp_sm"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/kl3_nav_item_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:paddingLeft="@dimen/kl3_gap"
    android:paddingRight="@dimen/kl3_gap"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/navIcon"
        android:layout_width="@dimen/kl3_avatar_s"
        android:layout_height="@dimen/kl3_avatar_s"
        android:tint="@color/kl3_icon_tint"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/navLabel"
        style="@style/KL3.Text.Body"
        android:textColor="@color/kl3_nav_text"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/kl3_gap" />
</LinearLayout>
