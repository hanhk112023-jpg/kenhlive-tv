<?xml version="1.0" encoding="utf-8"?>
<!-- KL4 nav rail item (Android TV) — TEXT ONLY, không icon.
     Focus ring = kl3_fg_focus foreground; selected = accent text (kl3_nav_text)
     + nền accent mềm (kl3_nav_item_bg). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="@dimen/kl3_sp_sm"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/kl3_nav_item_bg"
    android:foreground="@drawable/kl3_fg_focus"
    android:paddingLeft="@dimen/kl3_gap"
    android:paddingRight="@dimen/kl3_gap"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginRight="@dimen/kl3_gap"
        android:background="@drawable/kl3_nav_rail_bar" />

    <TextView
        android:id="@+id/navLabel"
        style="@style/KL3.Text.Nav"
        android:textSize="@dimen/kl3_ts_section"
        android:textColor="@color/kl3_nav_text"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
