<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_nav_item"
    android:foreground="@drawable/fg_focus"
    android:paddingLeft="14dp"
    android:paddingRight="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/navIcon"
        android:layout_width="@dimen/nav_icon"
        android:layout_height="@dimen/nav_icon"
        android:tint="@color/csl_nav_icon"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/navLabel"
        style="@style/KL.Text.Nav"
        android:textColor="@color/csl_nav_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:textSize="@dimen/ts_nav" />
</LinearLayout>
