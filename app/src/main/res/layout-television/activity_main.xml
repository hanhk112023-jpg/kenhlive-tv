<?xml version="1.0" encoding="utf-8"?>
<!-- ANDROID TV Layout:
     Điều hướng qua Home Hub (không có navigation rail).
     Main content fills 100% full screen width. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl_bg_deep">

    <!-- MAIN CONTENT: 100% full màn hình chiều ngang -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
