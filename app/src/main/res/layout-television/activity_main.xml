<?xml version="1.0" encoding="utf-8"?>
<!-- ANDROID TV / Tablet layout matching IMG_2815:
     Slim persistent left navigation rail + full content on right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/kl_bg_deep">

    <!-- SLIM LEFT NAVIGATION RAIL (kieu IMG_2815) -->
    <LinearLayout
        android:id="@+id/railPanel"
        android:layout_width="@dimen/rail_slim_w"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_tv_rail_panel"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <!-- User / Profile circle avatar at top -->
        <FrameLayout
            android:id="@+id/nav_profile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/avatar_ring"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user_circle"
                android:contentDescription="Tài khoản" />
        </FrameLayout>

        <!-- 1. Search Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_search" />

        <!-- 2. Home / Live Sports Icon (active) -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_live" />

        <!-- 3. MultiView / Đa màn hình Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_multiview" />

        <!-- 4. Sports / Soccer Ball Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_schedule" />

        <!-- 5. Highlights / Movies Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_replay" />

        <!-- 6. Favorites Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_fav" />

        <!-- 7. Categories / Apps Icon -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_cats" />

        <!-- Spacer pushes Settings to the bottom -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 8. Settings Icon at bottom -->
        <include layout="@layout/item_nav_slim" android:id="@+id/nav_settings" />
    </LinearLayout>

    <!-- MAIN CONTENT: 100% chieu ngang con lai cua man hinh -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
