<?xml version="1.0" encoding="utf-8"?>
<!-- ANDROID TV shell: noi dung full-bleed; rail trai la collapsible/expandable overlay
     khi nguoi dung nhan LEFT o canh trai -> rail mo ra kieu Google TV / Netflix / FPT,
     khi chon tab hoac an RIGHT -> rail tu dong dong lai. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl_bg_deep">

    <!-- CONTENT: full-bleed, 100% chieu ngang man hinh -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- SCRIM lam toi noi dung khi rail mo -->
    <View
        android:id="@+id/railScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:alpha="0"
        android:visibility="gone" />

    <!-- RAIL overlay: cao toan man, ngang bang rail_w, nam ngoai canh trai -->
    <LinearLayout
        android:id="@+id/railPanel"
        android:layout_width="@dimen/rail_w"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_tv_rail"
        android:elevation="24dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="26dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <!-- LOGO HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:layout_marginBottom="26dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_logo_kl"
                android:contentDescription="@string/cd_logo" />

            <TextView
                style="@style/KL.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_live_dot" />
        </LinearLayout>

        <!-- NAVIGATION ITEMS -->
        <include layout="@layout/item_nav_tv" android:id="@+id/nav_live" />
        <include layout="@layout/item_nav_tv" android:id="@+id/nav_schedule" />
        <include layout="@layout/item_nav_tv" android:id="@+id/nav_search" />
        <include layout="@layout/item_nav_tv" android:id="@+id/nav_settings" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- LIVE ROOMS COUNT BADGE -->
        <TextView
            android:id="@+id/countText"
            style="@style/KL.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/bg_badge_glass"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/kl_brand"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
